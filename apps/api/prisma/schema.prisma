// =============================================================================
// Advetics — Prisma Şeması
// Modül 1: Kiracılık, Kimlik Doğrulama, RBAC, White-Label Marka, Denetim
//
// NOT: RLS politikaları, partial unique index'ler ve CHECK constraint'leri
// Prisma ile ifade edilemez. Bunlar prisma/sql/ altında elle yazılmıştır ve
// `pnpm db:rls` ile uygulanır. Migration'dan sonra o adımı ATLAMA.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: advetics_app rolü — RLS UYGULANIR
  url       = env("DATABASE_URL")
  // Migration + seed: advetics_migrator rolü — tablo sahibi, BYPASSRLS
  directUrl = env("DIRECT_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enum'lar
// -----------------------------------------------------------------------------

enum OrgPlan {
  starter
  pro
  enterprise
}

enum OrgStatus {
  active
  suspended
}

enum UserStatus {
  active
  invited
  disabled
}

enum ClientStatus {
  active
  paused
  archived
}

enum Role {
  owner
  admin
  ad_manager
  manager
  analyst
  customer_service
  client_viewer
}

enum ActorType {
  user
  rule
  system
}

// Kapsam kilidi: yalnızca Meta ve Google Ads.
enum Platform {
  meta
  google
}

// -----------------------------------------------------------------------------
// Kiracılık
// -----------------------------------------------------------------------------

/// Ajansın kendisi. MVP'de tek satır; reseller/white-label satışı için gerekli.
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(60)
  plan      OrgPlan   @default(starter)
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  users           User[]
  clients         Client[]
  // Modül 2 — bağlantı, reklam hesabı ve sayfa ajansa ait, müşteriye değil.
  connections     PlatformConnection[]
  adAccounts      AdAccount[]
  socialProfiles  SocialProfile[]
  memberships     Membership[]
  branding        BrandingProfile[]
  auditLogs       AuditLog[]
  reportTemplates ReportTemplate[]
  monthlyBudgets  MonthlyBudget[]
  rules           Rule[]
  organicPosts    OrganicPost[]
  boostRules      BoostRule[]
  boosts          Boost[]
  bulkBatches     BulkBatch[]
  adDrafts        AdDraft[]
  leadForms       LeadForm[]
  leads           Lead[]
  leadCursors     LeadSyncCursor[]
  assets          Asset[]
  assetRefs       AssetPlatformRef[]
  adCreatives     AdCreative[]
  adCreativeLinks AdCreativeAsset[]
  draftCampaigns  DraftCampaign[]
  draftAdGroups   DraftAdGroup[]
  draftAds        DraftAd[]

  autoBoostPresets       AutoBoostPreset[]
  autoBoostQueueItems    AutoBoostQueueItem[]
  autoBoostSubscriptions AutoBoostSubscription[]
  userEmailAccounts      UserEmailAccount[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  orgId              String     @map("org_id") @db.Uuid
  /// Daima küçük harfe normalize edilerek saklanır (Zod `toLowerCase`).
  email              String     @db.VarChar(255)
  /// argon2id hash. SSO ile gelen kullanıcılarda null.
  passwordHash       String?    @map("password_hash") @db.Text
  fullName           String     @map("full_name") @db.VarChar(120)
  avatarUrl          String?    @map("avatar_url") @db.VarChar(1024)
  locale             String     @default("tr") @db.VarChar(10)
  /// TOTP secret — AES-256-GCM ile şifreli. (MFA Modül 1.5'te aktifleşir.)
  mfaSecretEnc       Bytes?     @map("mfa_secret_enc")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  /// İLK GİRİŞTE PAROLA DEĞİŞTİRME ZORUNLU MU.
  ///
  /// Seed ile ya da yönetici tarafından kurulan parolalar geçici sayılıyor:
  /// o parola en az bir kez kurulum sırasında bir insanın gözünden geçiyor
  /// (kurulum notu, sohbet, e-posta) ve kalıcı olmamalı.
  ///
  /// ⚠ BU ALAN BUGÜN HİÇBİR ŞEY YAPMIYOR — YAZILIYOR, HİÇ OKUNMUYOR.
  ///
  /// Burada bir süre "kullanıcı her ekranda uyarı görüyor" yazıyordu ve bu
  /// DOĞRU DEĞİLDİ: alan `createMember` ve `seed-portfolio` tarafından
  /// yazılıyor ama giriş, oturum kurulumu, `SessionResponse` tipi ve panelin
  /// hiçbir yeri onu okumuyor. Yani yöneticinin belirlediği geçici parola,
  /// kullanıcı isterse kalıcı. Yanlış yorum, güvenliğin var olduğu izlenimi
  /// veriyordu — olmayan bir korumadan daha kötüsü, olduğu sanılan bir koruma.
  ///
  /// ZORLAMAYI YAZAN KİŞİYE İKİ NOT:
  ///   1. Alan hiçbir yerde TEMİZLENMİYOR de. `changePassword` ve
  ///      `confirmPasswordReset` yalnızca `password_hash` güncelliyor;
  ///      sıfırlamayı iki yola da eklemezsen zorlama KİLİT DÖNGÜSÜ olur.
  ///   2. Panelde parola değiştirme ekranı YOK. `POST /auth/password/change`
  ///      ucu var ama `apps/web` içinde onu çağıran tek satır bile yok —
  ///      yani zorlamadan önce o ekran yazılmalı, yoksa kullanıcı zorlanır
  ///      ve yapabileceği bir şey olmaz.
  ///
  /// Girişi tamamen bloklamak da çözüm değil: kendi parolasını değiştirmek
  /// için giriş yapması gereken bir kullanıcıyı kilitler.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  status             UserStatus @default(invited)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships        Membership[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  connectionsCreated PlatformConnection[]
  emailAccount       UserEmailAccount?

  @@unique([orgId, email])
  @@index([orgId, status])
  @@map("users")
}

/// Ajansın müşterileri. Tüm reklam verisi bu düğüme asılır.
model Client {
  id                String       @id @default(uuid()) @db.Uuid
  orgId             String       @map("org_id") @db.Uuid
  name              String       @db.VarChar(120)
  slug              String       @db.VarChar(60)
  /// IANA timezone. "Bugünün harcaması" tanımı buna bağlıdır.
  timezone          String       @default("Europe/Istanbul") @db.VarChar(64)
  /// Çok para birimli toplamada hedef kur (fx_rates ile çevrilir).
  reportingCurrency String       @default("TRY") @map("reporting_currency") @db.Char(3)
  status            ClientStatus @default(active)

  /// Meta özel reklam kategorileri — HOUSING | EMPLOYMENT | CREDIT | ...
  ///
  /// MÜŞTERİNİN ÖZELLİĞİ, KAMPANYANIN DEĞİL: bir emlak firması her
  /// kampanyasında emlakçı ve her kampanyada tek tek sormak bir gün
  /// unutulacağı anlamına gelir. Beyan edilmeden yayınlanan reklam politika
  /// ihlali ve cezası HESAP seviyesinde — yani ajansın o hesaptaki bütün
  /// kampanyalarını riske atıyor.
  specialAdCategories String[] @default([]) @map("special_ad_categories")

  /// İLETİŞİM VE FATURA BİLGİSİ — hepsi opsiyonel.
  ///
  /// `contact_email` rapor gönderiminin okuyacağı alan. Bilgi bir kez burada
  /// duruyor; ön ayarda (`auto_boost_presets`) TUTULMUYOR çünkü bir müşterinin
  /// iki ön ayarı olabiliyor ve adresin iki kopyası, birinin güncellenmemesi
  /// demekti.
  ///
  /// Zorunlu DEĞİL: müşteri açmanın ilk amacı hesapları bağlamak. Zorunlu alan
  /// eklemek, elinde fatura bilgisi olmayan birinin müşteriyi hiç açamaması
  /// demekti.
  contactName  String? @map("contact_name") @db.VarChar(120)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(40)
  website      String? @db.VarChar(255)
  address      String? @db.VarChar(500)
  taxOffice    String? @map("tax_office") @db.VarChar(120)
  taxNumber    String? @map("tax_number") @db.VarChar(40)
  iban         String? @db.VarChar(34)
  notes        String? @db.VarChar(2000)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  branding     BrandingProfile?

  // Modül 2
  connections    PlatformConnection[]
  adAccounts     AdAccount[]
  socialProfiles SocialProfile[]

  // Modül 3
  campaigns Campaign[]
  adGroups  AdGroup[]
  ads       Ad[]
  creatives Creative[]
  syncJobs  SyncJob[]

  reportTemplates ReportTemplate[]
  reportShares    ReportShare[]
  monthlyBudgets  MonthlyBudget[]
  rules           Rule[]
  organicPosts    OrganicPost[]
  boostRules      BoostRule[]
  boosts          Boost[]
  bulkBatches     BulkBatch[]
  adDrafts        AdDraft[]
  keywordInsights KeywordInsight[]
  insightBreakdowns InsightBreakdown[]
  leadForms       LeadForm[]
  leads           Lead[]
  leadCursors     LeadSyncCursor[]
  assets          Asset[]
  adCreatives     AdCreative[]
  draftCampaigns  DraftCampaign[]

  autoBoostPresets       AutoBoostPreset[]
  autoBoostQueueItems    AutoBoostQueueItem[]
  autoBoostSubscriptions AutoBoostSubscription[]
  searchTermInsights     SearchTermInsight[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("clients")
}

/// Kullanıcı ↔ erişim yetkisi. RLS'in dayandığı tablodur.
model Membership {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  orgId       String  @map("org_id") @db.Uuid
  /// null => org geneli erişim (yalnızca owner/admin).
  /// Bunun tekilliği partial unique index ile korunur — bkz. prisma/sql/01_constraints.sql
  clientId    String? @map("client_id") @db.Uuid
  role        Role
  /// Yetki override: { "rule.activate": false }. Rolü daima ezer.
  permissions Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([orgId])
  @@index([clientId])
  @@map("memberships")
}

// -----------------------------------------------------------------------------
// White-Label
// -----------------------------------------------------------------------------

/// clientId null => organizasyon varsayılanı.
/// Bir client'a özel profil yoksa org varsayılanına geri düşülür.
model BrandingProfile {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  clientId String? @unique @map("client_id") @db.Uuid

  logoUrl     String? @map("logo_url") @db.VarChar(1024)
  logoDarkUrl String? @map("logo_dark_url") @db.VarChar(1024)
  faviconUrl  String? @map("favicon_url") @db.VarChar(1024)

  primaryColor String @default("#E11D2E") @map("primary_color") @db.VarChar(9)
  accentColor  String @default("#F97316") @map("accent_color") @db.VarChar(9)
  fontFamily   String @default("Inter") @map("font_family") @db.VarChar(120)

  /// Rapor paylaşım linklerinin servis edileceği alan adı.
  customDomain      String?   @unique @map("custom_domain") @db.VarChar(255)
  domainVerifiedAt  DateTime? @map("domain_verified_at") @db.Timestamptz(6)
  /// DNS TXT doğrulaması için tek kullanımlık değer.
  domainVerifyToken String?   @map("domain_verify_token") @db.VarChar(64)

  emailFromName    String  @default("Advetics") @map("email_from_name") @db.VarChar(120)
  emailFromAddress String? @map("email_from_address") @db.VarChar(255)
  footerText       String? @map("footer_text") @db.VarChar(500)
  hidePoweredBy    Boolean @default(false) @map("hide_powered_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("branding_profiles")
}

// -----------------------------------------------------------------------------
// Oturum ve kimlik doğrulama
// -----------------------------------------------------------------------------

/// Refresh token'ın kendisi DEĞİL, SHA-256 hash'i saklanır.
/// `familyId` rotasyon zinciridir: kullanılmış bir token tekrar sunulursa
/// (token theft göstergesi) tüm aile iptal edilir.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  familyId  String @map("family_id") @db.Uuid

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)
  replacedById  String?   @map("replaced_by_id") @db.Uuid

  ip        String?  @db.Inet
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Denetim
// -----------------------------------------------------------------------------

/// Kim, ne zaman, neyi değiştirdi.
/// Bu üründe bütçeler değişiyor — bu tablo pazarlık konusu değildir.
/// Modül 5'te kural motoru buraya actorType='rule' ile yazacak.
model AuditLog {
  id       BigInt  @id @default(autoincrement())
  orgId    String  @map("org_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid

  actorType  ActorType @default(user) @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  actorLabel String?   @map("actor_label") @db.VarChar(255)

  /// Nokta ile ayrılmış eylem anahtarı: `client.created`, `budget.increased`
  action     String  @db.VarChar(80)
  targetType String? @map("target_type") @db.VarChar(60)
  targetId   String? @map("target_id") @db.VarChar(128)

  before Json? @db.JsonB
  after  Json? @db.JsonB

  ip        String?  @db.Inet
  userAgent String?  @map("user_agent") @db.VarChar(512)
  requestId String?  @map("request_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// =============================================================================
// MODÜL 2 — Platform Bağlantıları
// =============================================================================

enum ConnectionStatus {
  active
  /// Token geçersiz (Meta #190 / Google AUTHENTICATION_ERROR). Kullanıcı
  /// yeniden yetkilendirene kadar tüm senkronizasyon durur.
  needs_reauth
  /// Kullanıcı bağlantıyı kaldırdı. Kayıt silinmez — denetim izi ve
  /// yeniden bağlanmada aynı hesapları tanımak için tutulur.
  revoked
  /// Tekrarlayan API hatası. Circuit breaker bu durumu kullanır.
  error
}

enum AdAccountStatus {
  active
  paused
  /// Platform tarafında kapatılmış/askıya alınmış.
  disabled
  closed
  unknown
}

enum SocialProfileType {
  facebook_page
  instagram_business
  /// Advetics 1.0 — bağlı YouTube kanalı. Instagram hesabıyla aynı yerde
  /// duruyor: ikisi de müşteriye atanan, içerik üreten bir hesap.
  youtube_channel
}

/// Bir OAuth yetkilendirmesi = bir Meta Business veya Google Ads kullanıcı izni.
///
/// Token'lar ASLA düz metin saklanmaz: CryptoService (AES-256-GCM) ile
/// şifrelenir ve her değerin başına anahtar sürümü yazılır, böylece anahtar
/// rotasyonu eski kayıtları okunamaz hale getirmez.
///
/// BAĞLANTI AJANSA AİT, MÜŞTERİYE DEĞİL. Sahiplik `org_id`'de; `client_id`
/// yalnızca bağlantı gerçekten tek bir müşteriye özelse (müşteri kendi Meta
/// hesabını devrettiyse) dolu olur.
///
/// Model müşteri bazlıyken ajansın tek Meta kimliğini 12 müşteri için 12 kez
/// yetkilendirmek gerekiyordu ve Meta her yeni yetkilendirmede öncekinin
/// token'ını geçersiz kılıyordu: bir müşteriye hesap bağlayınca diğerinin
/// bağlantısı KOPUYORDU. Canlıda gözlendi. Tekillik artık `org_id` üzerinde,
/// yani aynı kimlik bir kez yetkilendiriliyor.
model PlatformConnection {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  /// null => ajans geneli bağlantı. Hesaplar havuza düşer, müşteriye ayrıca
  /// atanır.
  clientId String?  @map("client_id") @db.Uuid
  platform Platform

  /// Platform tarafındaki kullanıcı/işletme kimliği. Aynı hesabın iki kez
  /// bağlanmasını tespit etmek için kullanılır.
  externalUserId String @map("external_user_id") @db.VarChar(128)
  /// UI'da gösterilen ad — "Advetics Business Manager" gibi.
  accountLabel   String @map("account_label") @db.VarChar(200)

  accessTokenEnc  Bytes     @map("access_token_enc")
  /// Google için zorunlu (access token 1 saatte dolar). Meta long-lived
  /// token'da null olabilir.
  refreshTokenEnc Bytes?    @map("refresh_token_enc")
  keyVersion      Int       @default(1) @map("key_version")
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz(6)

  grantedScopes String[] @map("granted_scopes")

  status         ConnectionStatus @default(active)
  lastErrorCode  String?          @map("last_error_code") @db.VarChar(80)
  lastErrorAt    DateTime?        @map("last_error_at") @db.Timestamptz(6)
  /// Token'ın en son doğrulandığı an. Sağlık göstergesi.
  lastVerifiedAt DateTime?        @map("last_verified_at") @db.Timestamptz(6)
  /// Ardışık hata sayacı. Circuit breaker eşiği.
  failureCount   Int              @default(0) @map("failure_count")

  connectedByUserId String    @map("connected_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull, Cascade DEĞİL: müşteri silinince ajansın bağlantısı ölmemeli,
  /// yalnızca müşteriyle olan bağı kopmalı.
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  connectedBy    User            @relation(fields: [connectedByUserId], references: [id])
  adAccounts     AdAccount[]
  socialProfiles SocialProfile[]

  @@unique([orgId, platform, externalUserId])
  @@index([orgId, status])
  @@index([clientId, status])
  @@index([status, tokenExpiresAt])
  @@map("platform_connections")
}

/// Reklam hesabı. Meta `act_123456789`, Google `1234567890`.
///
/// HESAP AJANSIN HAVUZUNDA DURUR, müşteriye ATANIR. Ajansın tek Meta kimliği
/// 157, tek Google girişi 127 hesaba erişiyor; bunların hepsini bağlantıyı
/// kuran müşteriye yazmak 12 müşteride 12 × 157 mükerrer satır üretiyordu.
/// Tekillik `[platform, externalId, orgId]` — aynı reklam hesabı bir
/// organizasyonda TEK satır.
model AdAccount {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  /// null => havuzda, henüz hiçbir müşteriye atanmamış. Atanmamış hesap
  /// senkronize EDİLMEZ: `client_id`'si NULL bir `sync_jobs` satırı RLS
  /// altında kimseye görünmez ve iş sessizce kaybolurdu.
  clientId     String?  @map("client_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  platform     Platform

  externalId String @map("external_id") @db.VarChar(128)
  name       String @db.VarChar(200)

  /// Hesabın kendi para birimi. Rapor para biriminden FARKLI olabilir;
  /// kümülatif harcama fx_rates ile çevrilerek hesaplanır.
  currency String @db.Char(3)
  /// Insight tarihleri bu zaman diliminde. "Bugün"ün tanımı buna bağlı.
  timezone String @db.VarChar(64)

  status            AdAccountStatus @default(unknown)
  /// Google MCC / Meta Business Manager kimliği.
  managerExternalId String?         @map("manager_external_id") @db.VarChar(128)

  /// Kullanıcı bu hesabı senkronize etmek istiyor mu. Bağlantı kurulduğunda
  /// hesaplar KEŞFEDİLİR ama varsayılan olarak KAPALIDIR — 40 hesaplı bir
  /// Business Manager'ı bağlayan biri istemeden 40 hesabın kotasını yakmasın.
  syncEnabled Boolean @default(false) @map("sync_enabled")

  lastStructureSyncAt DateTime? @map("last_structure_sync_at") @db.Timestamptz(6)
  lastInsightsSyncAt  DateTime? @map("last_insights_sync_at") @db.Timestamptz(6)
  /// Son kota okuması (Meta BUC yüzdeleri / Google operasyon sayacı).
  /// Modül 3'teki adaptif hız sınırlayıcı bunu kullanır.
  rateLimitState      Json?     @map("rate_limit_state") @db.JsonB

  raw       Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull, Cascade DEĞİL: müşteri silinince hesap ajansın havuzuna GERİ
  /// DÖNER. Cascade olsaydı müşteri silmek ajansın kendi reklam hesabı
  /// kaydını da silerdi.
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  connection         PlatformConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  boostTargets       SocialProfile[]     @relation("BoostBillingAccount")
  campaigns          Campaign[]
  budgets            MonthlyBudget[]
  rules              Rule[]
  boosts             Boost[]
  adDrafts           AdDraft[]
  draftCampaigns     DraftCampaign[]
  keywordInsights    KeywordInsight[]
  insightBreakdowns  InsightBreakdown[]
  bulkBatches        BulkBatch[]
  assetRefs          AssetPlatformRef[]
  searchTermInsights SearchTermInsight[]

  @@unique([platform, externalId, orgId])
  @@index([orgId, clientId])
  @@index([clientId, syncEnabled])
  @@index([connectionId])
  @@map("ad_accounts")
}

/// Facebook sayfası veya Instagram Business hesabı — Auto-Boost (Modül 7) için.
/// SADECE Meta. Google'da karşılığı yoktur.
model SocialProfile {
  id           String  @id @default(uuid()) @db.Uuid
  orgId        String  @map("org_id") @db.Uuid
  /// null => havuzda, henüz hiçbir müşteriye atanmamış. Atanmamış sayfa
  /// senkronize EDİLMEZ ve üzerine form/reklam kurulamaz: `organic_posts`,
  /// `leads` ve `lead_forms` satırları `client_id` taşıyor ve NULL yazılan
  /// satırı RLS kimseye göstermez.
  clientId     String? @map("client_id") @db.Uuid
  connectionId String  @map("connection_id") @db.Uuid

  profileType SocialProfileType @map("profile_type")
  externalId  String            @map("external_id") @db.VarChar(128)
  username    String?           @db.VarChar(200)
  name        String            @db.VarChar(200)
  pictureUrl  String?           @map("picture_url") @db.VarChar(1024)

  /// INSTAGRAM SATIRLARININ ANA FACEBOOK SAYFASI. Facebook satırlarında NULL.
  ///
  /// NEDEN GEREKLİ: Meta'da her reklam bir Facebook sayfasına bağlı —
  /// Instagram'a yayınlanan reklam da. Instagram satırında `external_id`
  /// SAYFA KİMLİĞİ DEĞİL, IG kullanıcı kimliği; ikisi farklı kimlik uzayı ve
  /// birini diğerinin yerine göndermek boost yolunun bugünkü hatasıydı
  /// (bkz. `instagram-boost-guard.ts`).
  ///
  /// NEDEN KİMLİK, NEDEN KENDİNE YABANCI ANAHTAR DEĞİL: değer Meta'ya
  /// gönderilecek olanın ta kendisi ve keşif sırasında satır sırasına
  /// bağımlılık yaratmıyor. Ayrıca sayfa satırı silinse bile Instagram
  /// hesabının boost'u çalışmaya devam ediyor — sayfa token'ı zaten bu
  /// satırda. Yabancı anahtar olsaydı `SET NULL` ile silinir ve çalışan bir
  /// yol sessizce kapanırdı.
  ///
  /// NULL BİR INSTAGRAM SATIRI = HENÜZ YENİDEN KEŞFEDİLMEMİŞ. Bu kolon
  /// eklenmeden önce keşfedilen satırlarda boş; "Hesapları yenile" bir kez
  /// çalıştırılınca doluyor. K17'nin Instagram dalı yazıldığında NULL bir
  /// değerle boost DENENMEMELİ — erken hata verilmeli, yoksa yine yanlış
  /// kimlik gönderilir.
  parentPageExternalId String? @map("parent_page_external_id") @db.VarChar(128)

  /// Boost'un faturalanacağı reklam hesabı. Kullanıcı seçer.
  linkedAdAccountId String? @map("linked_ad_account_id") @db.Uuid

  /// Sayfa token'ı kullanıcı token'ından AYRIDIR ve ayrı şifrelenir.
  pageAccessTokenEnc Bytes? @map("page_access_token_enc")
  keyVersion         Int    @default(1) @map("key_version")

  syncEnabled Boolean   @default(false) @map("sync_enabled")
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)

  raw       Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull, Cascade DEĞİL: müşteri silinince sayfa ajansın havuzuna döner.
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  connection      PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  linkedAdAccount AdAccount?         @relation("BoostBillingAccount", fields: [linkedAdAccountId], references: [id], onDelete: SetNull)
  organicPosts    OrganicPost[]
  boostRules      BoostRule[]
  adDrafts        AdDraft[]
  draftAdGroups   DraftAdGroup[]
  leadForms       LeadForm[]
  leads           Lead[]
  leadCursors     LeadSyncCursor[]

  /// Tekillik ORGANİZASYON bazında: ikinci bir Meta kimliği bağlandığında aynı
  /// Facebook sayfası iki bağlantının da altında görünüyor ve bağlantı bazlı
  /// kısıt aynı sayfa için iki satır üretirdi.
  autoBoostPresets      AutoBoostPreset[]
  autoBoostQueueItems   AutoBoostQueueItem[]
  autoBoostSubscription AutoBoostSubscription?

  @@unique([orgId, externalId])
  @@index([orgId, clientId])
  @@index([clientId, syncEnabled])
  @@map("social_profiles")
}

/// OAuth `state` parametresi — CSRF koruması ve tek kullanımlık eşleştirme.
///
/// Neden tablo, neden imzalı JWT değil: callback'te tek kullanımlığı
/// GARANTİ etmek gerekiyor. İmzalı bir token tekrar sunulabilir; veritabanı
/// satırı `consumedAt` ile bir kez tüketilir. Token'ın kendisi değil SHA-256
/// hash'i saklanır.
model OAuthState {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  /// null => ajans geneli yetkilendirme. Dolu olması yalnızca akışın belirli
  /// bir müşteri için başlatıldığı hâli anlatır (müşteri kendi hesabını
  /// devretmişse).
  clientId  String?  @map("client_id") @db.Uuid
  platform  Platform
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)

  /// Yetkilendirme sonrası dönülecek panel yolu.
  redirectTo      String?  @map("redirect_to") @db.VarChar(512)
  /// Talep edilen scope'lar — callback'te platformun verdikleriyle karşılaştırılır.
  requestedScopes String[] @map("requested_scopes")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  ip              String?   @db.Inet
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@index([clientId])
  @@map("oauth_states")
}

enum DataDeletionStatus {
  received
  completed
  failed
}

/// Platform tarafından tetiklenen veri silme talebi.
///
/// Meta, veri işleyen uygulamalardan makineyle çağrılabilir bir silme uç noktası
/// istiyor: imzalı istek gelir, veri silinir, kullanıcının durumu
/// sorgulayabileceği bir onay kodu ve URL döndürülür.
///
/// RLS: bu tabloda POLİTİKA YOK — `advetics_app` rolü hiçbir satır göremez.
/// Kasıtlı: kayıtlar yalnızca (a) kimlik doğrulamasız webhook ve (b) herkese
/// açık durum sorgusu tarafından okunur, ikisi de yönetim bağlantısını kullanır.
/// Bir tenant'ın bu tabloyu görmesi için hiçbir sebep yok.
model DataDeletionRequest {
  id       String   @id @default(uuid()) @db.Uuid
  platform Platform

  /// Platform tarafındaki kullanıcı kimliği (Meta user_id).
  externalUserId   String @map("external_user_id") @db.VarChar(128)
  /// Kullanıcının durumu sorgulayacağı kod. URL'de görünür, tahmin edilemez olmalı.
  confirmationCode String @unique @map("confirmation_code") @db.VarChar(64)

  status DataDeletionStatus @default(received)

  /// Silinen bağlantı sayısı ve etkilenen müşteriler — hesap verebilirlik için.
  deletedConnections Int   @default(0) @map("deleted_connections")
  affectedClientIds  Json? @map("affected_client_ids") @db.JsonB

  errorMessage String?   @map("error_message") @db.VarChar(500)
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  ip           String?   @db.Inet

  @@index([externalUserId])
  @@index([requestedAt])
  @@map("data_deletion_requests")
}

// =============================================================================
// MODÜL 3 — Birleşik Reklam Hiyerarşisi ve Metrikler
// =============================================================================
//
// TASARIM KARARI: Meta ve Google TEK şemaya normalize edilir
// (Campaign → AdGroup → Ad). Meta'nın "Ad Set"i ve Google'ın "Ad Group"u aynı
// tabloya oturur. "Unified Workspace" ve "Ads Explorer"ı mümkün kılan şey budur.
// Platforma özgü her şey `raw` JSONB'de yaşar.

enum EntityStatus {
  active
  paused
  deleted
  pending_review
  ended
  unknown
}

enum BudgetMode {
  daily
  lifetime
  /// Bütçe üst seviyede tanımlı (Meta CBO / Google kampanya bütçesi).
  none
}

enum EntityLevel {
  account
  campaign
  ad_group
  ad
}

enum ReportStatus {
  draft
  /// Paylaşım linki üretilmiş.
  published
  archived
}

enum SyncJobType {
  /// L1 — kampanya/adset/ad meta verisi, durum, bütçe
  structure
  /// L2 — bugünün metrikleri, yalnızca account + campaign
  insights_realtime
  /// L3 — dün, tüm seviyeler
  insights_daily
  /// L4 — atıf penceresi geri düzeltmesi
  insights_backfill
  /// L5 — kırılımlar (opt-in)
  insights_breakdown
  /// Anahtar kelime performansı — yalnızca Google, yalnızca arama kampanyaları
  keyword_insights
  /// L6 — organik post metrikleri (Auto-Boost)
  organic_posts
  /// Modül 5 — kural değerlendirmesi. Platform verisi ÇEKMİYOR, mevcut
  /// veriyi okuyup karar veriyor; API çağrısı yalnızca aksiyon uygulanırken
  /// ve kuralın kendi `rule_action` kota katmanından yapılıyor.
  rules_evaluate
  /// Modül 7 — boost kuralı değerlendirmesi + onaylanmışların oluşturulması.
  boosts_evaluate
  /// Webhook'un bildirdiği tek bir potansiyel müşteri kaydının alanlarını çeker.
  lead_fetch
  /// Bir formun kaçmış kayıtlarını tarar — webhook teslimi garanti değil.
  leads_reconcile
  /// L7 — yeni hesap bağlandığında geçmiş
  initial_backfill
  /// Advetics 1.0 — YouTube WebSub aboneliklerini yeniler.
  ///
  /// Kiralama ~10 günde doluyor ve hub haber vermiyor; yenilenmezse bildirim
  /// SESSİZCE duruyor. Bu iş küresel bir tarama, müşteri başına dağılmıyor.
  websub_renew
  /// Advetics 1.0 — süresi dolmuş boost'ları 'completed' yapar.
  ///
  /// Bu tarama olmadan bir gönderi bir kez boostlandıktan sonra BİR DAHA
  /// boostlanamıyor: `boosts_active_post_uniq` kısmi tekil indeksi 'active'
  /// durumunu kapsıyor ve hiçbir kod yolu o durumdan çıkmıyordu. Küresel
  /// tarama, müşteri başına dağılmıyor.
  boost_complete
  /// Google arama terimleri — kullanıcının yazdığı sorgular.
  search_terms
  /// Advetics 1.0 — reklam hesaplarının PLATFORMDAKİ durumunu tazeler ve
  /// ödeme sorunu bulursa ajansa mail atar.
  ///
  /// Ayrı bir tür olmasının sebebi `structure`dan farklı bir şey yapması:
  /// yapı taraması bir hesabın İÇİNİ (kampanya, grup, reklam) okuyor,
  /// bu iş hesabın KENDİSİNİ (account_status, customer.status) okuyor ve
  /// o bilgi başka hiçbir zamanlanmış işte tazelenmiyordu — yalnızca
  /// kullanıcı elle "Hesapları yenile" dediğinde.
  account_status
  /// Advetics 1.0 — yaş/cinsiyet/yerleşim/saat/şehir kırılımları.
  /// `insights_breakdown` KOTA KATMANI ile karıştırılmasın: o bir hız
  /// sınırlama etiketi, bu bir iş türü.
  insights_breakdowns
}

enum SyncJobStatus {
  queued
  running
  succeeded
  /// Kota nedeniyle geri çekildi; next_retry_at sonra tekrar denenir.
  throttled
  failed
  cancelled
}

model Campaign {
  id          String   @id @default(uuid()) @db.Uuid
  adAccountId String   @map("ad_account_id") @db.Uuid
  /// Denormalize — RLS ve hızlı filtre için. Join'siz sorgu maliyeti düşer.
  clientId    String   @map("client_id") @db.Uuid
  platform    Platform

  externalId String @map("external_id") @db.VarChar(128)
  name       String @db.VarChar(512)

  /// Normalize edilmiş amaç. Platformların ham değerleri `raw` içinde.
  objective       String?      @db.VarChar(60)
  status          EntityStatus @default(unknown)
  /// Platformun ham durumu — "PAUSED" ile "CAMPAIGN_PAUSED" farkını korur.
  effectiveStatus String?      @map("effective_status") @db.VarChar(60)

  budgetMode         BudgetMode @default(none) @map("budget_mode")
  /// Para MICROS cinsinden. Float ile para tutmak toplama sırasına göre
  /// kuruş kaymaları üretir; Google Ads API zaten micros kullanıyor.
  budgetAmountMicros BigInt?    @map("budget_amount_micros")
  bidStrategy        String?    @map("bid_strategy") @db.VarChar(60)

  startTime DateTime? @map("start_time") @db.Timestamptz(6)
  stopTime  DateTime? @map("stop_time") @db.Timestamptz(6)

  raw               Json?     @db.JsonB
  /// Delta senkronizasyonun anahtarı: bundan yenisini çekmek yeter.
  platformUpdatedAt DateTime? @map("platform_updated_at") @db.Timestamptz(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  /// Soft delete — platformda silinen kampanyanın geçmiş metrikleri korunur.
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adGroups  AdGroup[]

  @@unique([platform, externalId])
  @@index([clientId, status])
  @@index([adAccountId, platformUpdatedAt])
  @@map("campaigns")
}

/// Meta'da "Ad Set", Google'da "Ad Group". Aynı tablo.
model AdGroup {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  adAccountId String   @map("ad_account_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  platform    Platform

  externalId String @map("external_id") @db.VarChar(128)
  name       String @db.VarChar(512)

  status          EntityStatus @default(unknown)
  effectiveStatus String?      @map("effective_status") @db.VarChar(60)

  budgetMode         BudgetMode @default(none) @map("budget_mode")
  budgetAmountMicros BigInt?    @map("budget_amount_micros")
  bidAmountMicros    BigInt?    @map("bid_amount_micros")
  optimizationGoal   String?    @map("optimization_goal") @db.VarChar(60)
  /// Hedefleme spec'i — Modül 8 toplu oluşturucuda şablon olarak kullanılacak.
  targeting          Json?      @db.JsonB

  startTime DateTime? @map("start_time") @db.Timestamptz(6)
  stopTime  DateTime? @map("stop_time") @db.Timestamptz(6)

  raw               Json?     @db.JsonB
  platformUpdatedAt DateTime? @map("platform_updated_at") @db.Timestamptz(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@unique([platform, externalId])
  @@index([clientId, status])
  @@index([campaignId])
  @@map("ad_groups")
}

model Ad {
  id          String   @id @default(uuid()) @db.Uuid
  adGroupId   String   @map("ad_group_id") @db.Uuid
  adAccountId String   @map("ad_account_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  platform    Platform

  externalId String @map("external_id") @db.VarChar(128)
  name       String @db.VarChar(512)

  status          EntityStatus @default(unknown)
  effectiveStatus String?      @map("effective_status") @db.VarChar(60)

  creativeId         String? @map("creative_id") @db.Uuid
  previewUrl         String? @map("preview_url") @db.VarChar(1024)
  /// Reklam reddedildiyse sebepleri — Ads Explorer'da (Modül 4) gösterilecek.
  reviewStatus       String? @map("review_status") @db.VarChar(60)
  disapprovalReasons Json?   @map("disapproval_reasons") @db.JsonB

  raw               Json?     @db.JsonB
  platformUpdatedAt DateTime? @map("platform_updated_at") @db.Timestamptz(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adGroup  AdGroup   @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@unique([platform, externalId])
  @@index([clientId, status])
  @@index([adGroupId])
  @@map("ads")
}

model Creative {
  id          String   @id @default(uuid()) @db.Uuid
  adAccountId String   @map("ad_account_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  platform    Platform

  externalId   String  @map("external_id") @db.VarChar(128)
  creativeType String? @map("creative_type") @db.VarChar(40)

  headline       String? @db.VarChar(512)
  primaryText    String? @map("primary_text") @db.Text
  description    String? @db.Text
  ctaType        String? @map("cta_type") @db.VarChar(60)
  destinationUrl String? @map("destination_url") @db.VarChar(2048)
  displayUrl     String? @map("display_url") @db.VarChar(512)
  assetUrls      Json?   @map("asset_urls") @db.JsonB

  raw       Json?    @db.JsonB
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ads    Ad[]

  @@unique([platform, externalId])
  @@index([clientId])
  @@map("creatives")
}

/// Günlük metrikler — SİSTEMİN KALBİ.
///
/// Bu tablo `date` üzerinden AYLIK PARTITIONED'dır. Prisma partitioning'i ifade
/// edemediği için migration elle düzenlendi ve partition yönetimi
/// prisma/sql/03_partitions.sql içinde yaşıyor.
///
/// Birincil anahtar DOĞAL anahtardır: (date, entity_level, entity_id,
/// breakdown_key). Vekil bir id yok — partition anahtarının PK'nın parçası
/// olması zorunlu ve doğal anahtar zaten tekilliği sağlıyor. Bu, ayrı bir
/// UNIQUE index taşımaktan tasarruf ettiriyor ve `ON CONFLICT` ile idempotent
/// upsert'i doğrudan mümkün kılıyor.
///
/// TÜRETİLMİŞ METRİKLER (CPA, ROAS, CTR, CPM, CPC) BURADA SAKLANMAZ.
/// Sorgu anında hesaplanır. Sebep: bölme işlemi toplama sırasına duyarlıdır.
/// SUM(spend)/SUM(conv) ≠ AVG(cpa). Saklanan bir CPA, gruplandığında yanlış
/// sayı üretir ve o yanlış sayıyla kural motoru bütçe kapatır.
model InsightsDaily {
  clientId    String   @map("client_id") @db.Uuid
  adAccountId String   @map("ad_account_id") @db.Uuid
  platform    Platform

  entityLevel      EntityLevel @map("entity_level")
  /// İlgili tablonun id'si (campaign/ad_group/ad) veya ad_account id'si.
  entityId         String      @map("entity_id") @db.Uuid
  /// Join'siz sorgu için — Ads Explorer'da platform kimliğiyle arama yapılıyor.
  entityExternalId String      @map("entity_external_id") @db.VarChar(128)

  /// HESABIN KENDİ zaman diliminde. "Bugün"ün tanımı buna bağlı.
  date DateTime @db.Date

  /// '' = toplam. Aksi hâlde `device:mobile|country:TR` gibi kanonik bir dize.
  /// Boş dize kullanmak NULL'dan iyidir: NULL'lar PK'da eşleşmez ve mükerrer
  /// satır üretir.
  breakdownKey String @default("") @map("breakdown_key") @db.VarChar(255)
  breakdown    Json?  @db.JsonB

  impressions          Int     @default(0)
  clicks               Int     @default(0)
  /// Hesabın para biriminde, micros.
  spendMicros          BigInt  @default(0) @map("spend_micros")
  /// Müşterinin rapor para birimine çevrilmiş — fx_rates ile.
  spendMicrosReporting BigInt? @map("spend_micros_reporting")

  /// Google kesirli dönüşüm döndürür (0.75 gibi) — integer olamaz.
  conversions           Decimal @default(0) @db.Decimal(14, 4)
  conversionValueMicros BigInt  @default(0) @map("conversion_value_micros")

  videoViews  Int      @default(0) @map("video_views")
  engagements Int      @default(0)
  reach       Int      @default(0)
  frequency   Decimal? @db.Decimal(10, 4)

  /// Platforma özgü tüm alanlar. Yeni metrik desteği migration gerektirmiyor.
  rawMetrics Json?    @map("raw_metrics") @db.JsonB
  currency   String   @db.Char(3)
  /// Bayatlık göstergesi — kural motoru bunu okuyup eski veriyle aksiyon almayı reddediyor.
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([date, entityLevel, entityId, breakdownKey])
  @@index([clientId, date(sort: Desc), entityLevel])
  @@index([adAccountId, date(sort: Desc)])
  @@map("insights_daily")
}

/// Döviz kurları — çok para birimli "kümülatif harcama" ancak bununla doğru olur.
/// Meta hesabı TRY, Google hesabı USD ise toplamak matematiksel olarak anlamsızdır.
model FxRate {
  date          DateTime @db.Date
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  source        String   @db.VarChar(40)
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([date, baseCurrency, quoteCurrency])
  @@map("fx_rates")
}

/// Senkronizasyon işi — kuyruk durumunun kalıcı izi.
///
/// BullMQ işleri Redis'te yaşıyor ve Redis temizlendiğinde kaybolur. Bu tablo
/// "en son ne zaman senkronize edildi", "neden başarısız oldu", "kaç API çağrısı
/// harcandı" sorularının cevabını kalıcı tutuyor.
/// Rapor şablonu — hangi bölümler, hangi sırada, hangi başlıklarla.
///
/// Şablon MÜŞTERİ BAZINDA saklanıyor (clientId zorunlu) çünkü ajans her
/// müşteriye farklı şeyler gösteriyor: birinde WhatsApp mesajları önemli,
/// diğerinde anahtar kelimeler. Organizasyon geneli varsayılan şablon
/// `clientId = null` ile tutuluyor.
/// Danışman başına e-posta kimliği — rapor müşteriye ONUN adresinden gidiyor.
///
/// PAROLA ŞİFRELİ ve hiçbir okuma yolundan geri dönmüyor. Bir kullanıcının
/// uygulama parolasını saklamak, o hesabın adına mail gönderebilmek demek;
/// satır yalnızca SAHİBİNE görünüyor (RLS), org yöneticisi bile parolayı
/// okuyamıyor.
model UserEmailAccount {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  /// Tekil: bir kullanıcının tek e-posta kimliği var.
  userId String @unique @map("user_id") @db.Uuid

  fromName  String @map("from_name") @db.VarChar(160)
  fromEmail String @map("from_email") @db.VarChar(255)

  smtpHost    String  @map("smtp_host") @db.VarChar(255)
  smtpPort    Int     @map("smtp_port")
  smtpSecure  Boolean @default(true) @map("smtp_secure")
  smtpUser    String  @map("smtp_user") @db.VarChar(255)
  smtpPassEnc Bytes   @map("smtp_pass_enc")
  keyVersion  Int     @default(1) @map("key_version")

  /// İmza HTML'i — TEMİZLENMİŞ hâliyle saklanıyor.
  ///
  /// Gmail'in imzası SMTP ile giden maile otomatik eklenmiyor; onu Gmail'in
  /// arayüzü ekliyor. Girişte `script`/`style`/olay öznitelikleri atılıyor ve
  /// atılanlar kullanıcıya söyleniyor — sonradan sürpriz olmasın.
  signatureHtml String? @map("signature_html")

  /// "Kaydedildi" doğrulama DEĞİL: SMTP kimliği yanlışsa hata ilk gerçek
  /// gönderimde çıkar ve o gönderim müşteriye gidecek olandır. Kendine test
  /// maili gönderilmeden NULL kalıyor.
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error") @db.VarChar(500)
  lastErrorAt DateTime? @map("last_error_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("user_email_accounts")
}

model ReportTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  /// null = organizasyon varsayılanı.
  clientId String? @map("client_id") @db.Uuid

  name        String  @db.VarChar(160)
  /// Kapakta görünen başlık. Boşsa "Dijital Pazarlama Raporu".
  title       String? @db.VarChar(200)
  /// Kapanış sayfası metni.
  closingText String? @map("closing_text") @db.Text

  /// Bölümler SIRALI dizi olarak: ["cover","summary",...].
  ///
  /// Geçerli değerler `packages/shared` içindeki REPORT_SECTIONS listesinde ve
  /// Zod ile doğrulanıyor. Prisma enum'u OLARAK tanımlanmadı: hiçbir kolonun
  /// tipi olmadığı için Prisma onu veritabanında oluşturmuyor ve şemada
  /// karşılığı olmayan bir enum bildirmek yanlış izlenim verirdi.
  ///
  /// Neden ayrı tablo değil: sıra bir dizinin doğal özelliği ve satır bazlı
  /// `order` kolonu her yeniden sıralamada N satır güncellemek demek. Bölüm
  /// sayısı tek haneli, JSONB burada daha basit ve atomik.
  sections Json @db.JsonB

  /// Bölüm bazlı ayarlar: hangi metrik sütunları, kaç satır, hangi eşik.
  options Json? @db.JsonB

  status ReportStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shares       ReportShare[]

  @@index([orgId, clientId])
  @@map("report_templates")
}

/// Paylaşım linki — müşteriye gönderilen, oturum GEREKTİRMEYEN adres.
///
/// Token ayrı bir tabloda ve HASH'lenerek saklanıyor: veritabanı sızarsa
/// linkler geçersiz kalır. Aynı mantık refresh token'larda da var.
model ReportShare {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  clientId   String @map("client_id") @db.Uuid

  /// SHA-256. Ham token yalnızca üretim anında bir kez gösterilir.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// Raporun kapsadığı aralık — link SABİT bir dönemi gösteriyor.
  ///
  /// "Son 30 gün" gibi kayan bir aralık paylaşmak, müşterinin bir hafta sonra
  /// açtığında farklı sayılar görmesi demek. Rapor bir belge, canlı panel değil.
  dateFrom DateTime @map("date_from") @db.Date
  dateTo   DateTime @map("date_to") @db.Date

  /// Süresi dolmuş link 410 döner. null = süresiz.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Erişim izleme — müşteri raporu açtı mı.
  viewCount  Int       @default(0) @map("view_count")
  lastViewAt DateTime? @map("last_view_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  template ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
  @@map("report_shares")
}

/// Aylık bütçe — pacing, hard cap ve otomatik durdurmanın dayanağı.
///
/// İKİ SEVİYE:
///   · `adAccountId = null` → müşteri geneli bütçe (şirketin aylık toplamı)
///   · `adAccountId` dolu   → proje/hesap bazlı bütçe
///
/// Bir müşterinin birden fazla projesi olabiliyor ve ajans hem proje bazında
/// hem şirket toplamında bütçe tanımlamak istiyor. İkisi birlikte var olabilir:
/// hesap bütçeleri tek tek izlenir, müşteri bütçesi şemsiye olarak.
model MonthlyBudget {
  id          String  @id @default(uuid()) @db.Uuid
  orgId       String  @map("org_id") @db.Uuid
  clientId    String  @map("client_id") @db.Uuid
  /// null = müşteri geneli.
  adAccountId String? @map("ad_account_id") @db.Uuid

  /// Ayın İLK GÜNÜ. Ay bir aralık değil bir nokta olarak saklanıyor: "2026-08"
  /// yerine "2026-08-01" tutmak tarih aritmetiğini SQL'de doğrudan yapılabilir
  /// kılıyor ve string ay biçimiyle uğraşmayı ortadan kaldırıyor.
  month DateTime @db.Date

  /// Micros. Para her yerde micros — kayan noktayla para tutmak kuruş kaydırır.
  amountMicros BigInt @map("amount_micros")
  currency     String @db.Char(3)

  /// Günlük sert limit. Aşılırsa kampanyalar durdurulabilir (Modül 5).
  /// null = günlük limit yok.
  dailyCapMicros BigInt? @map("daily_cap_micros")

  /// Bu yüzdeye ulaşınca uyarı üretilir. Varsayılan %80.
  alertThresholdPct Int @default(80) @map("alert_threshold_pct")

  /// Bu yüzdeye ulaşınca kampanyalar OTOMATİK DURDURULUR.
  ///
  /// null = kapalı ve VARSAYILAN BU. Otomatik durdurma para harcamayı kesiyor
  /// ama aynı zamanda satışı da kesiyor; sessizce açık gelmemeli. Modül 5
  /// yazılana kadar bu alan yalnızca saklanıyor, uygulanmıyor.
  autoPauseAtPct Int? @map("auto_pause_at_pct")

  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  /// TEKİLLİK KISITI BURADA DEĞİL, migration'da.
  ///
  /// `@@unique([clientId, adAccountId, month])` YETMİYOR: Postgres'te NULL
  /// hiçbir şeye eşit değil, dolayısıyla `adAccountId IS NULL` olan iki satır
  /// çakışmıyor ve aynı ay için iki müşteri geneli bütçe girilebiliyor.
  /// Migration'da iki KISMİ tekil indeks var — bkz. 20260807_module5_budgets.
  @@index([clientId, month])
  @@index([adAccountId, month])
  @@map("monthly_budgets")
}

/// Kural motoru — Modül 5.
///
/// PROVA VARSAYILAN. `dryRun` true doğuyor ve canlıya almak `rule.activate`
/// yetkisi istiyor. Sebep asimetri: yanlış rapor düzeltilebilir, yanlış
/// durdurulan kampanyanın kaçırdığı satış geri gelmez.
model Rule {
  id          String  @id @default(uuid()) @db.Uuid
  orgId       String  @map("org_id") @db.Uuid
  clientId    String  @map("client_id") @db.Uuid
  /// null = müşterinin TÜM reklam hesapları.
  adAccountId String? @map("ad_account_id") @db.Uuid

  name        String  @db.VarChar(160)
  description String? @db.VarChar(1000)

  /// campaign | ad_group | ad. `account` YOK — hesap duraklatılamaz.
  level EntityLevel

  /// Koşul dizisi. JSONB çünkü koşul SAYISI ve şekli değişken; kolonlara
  /// açmak 5 koşul için 20 kolon demek olurdu ve 6. koşul migration
  /// gerektirirdi. Doğrulama Zod ile sınırda yapılıyor.
  conditions Json   @db.JsonB
  /// 'and' | 'or'. İç içe gruplama yok — okunamayan kural canlıya alınmamalı.
  combinator String @default("and") @db.VarChar(3)

  /// { type: 'pause' } | { type: 'adjust_budget', percent: 20, maxBudget: … }
  action Json @db.JsonB
  /// Minimum örneklem eşikleri — gürültüyle tetiklenmeyi engelliyor.
  guard  Json @db.JsonB

  /// Aynı varlığa iki aksiyon arasındaki bekleme. Salınımı engelliyor.
  cooldownMinutes  Int @default(1440) @map("cooldown_minutes")
  /// Tek çalıştırmada dokunulacak azami varlık — kazaya karşı son emniyet.
  maxActionsPerRun Int @default(20) @map("max_actions_per_run")
  /// Veri bu kadar saatten eskiyse hiçbir aksiyon alınmıyor.
  maxDataAgeHours  Int @default(36) @map("max_data_age_hours")

  enabled Boolean @default(true)
  /// Canlıya geçiş AYRI yetki. Varsayılan prova.
  dryRun  Boolean @default(true) @map("dry_run")

  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?      @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  runs         RuleRun[]
  actions      RuleActionLog[]

  @@index([clientId, enabled])
  @@index([enabled, lastRunAt])
  @@map("rules")
}

/// Kuralın tek bir değerlendirme turu.
///
/// AKSİYON ALINMASA DA kaydediliyor: "kuralım neden hiç çalışmıyor" sorusunun
/// cevabı çoğu zaman "çalıştı, hiçbir varlık koşulu sağlamadı". Yalnızca
/// aksiyonlu turları kaydetmek o soruyu cevaplanamaz kılardı.
model RuleRun {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid

  /// Turun ÇALIŞTIĞI ANDAKİ mod. Kuralın güncel `dryRun` değeri değil:
  /// kural sonradan canlıya alınırsa geçmiş turlar prova olarak kalmalı.
  dryRun Boolean @map("dry_run")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  evaluatedCount Int @default(0) @map("evaluated_count")
  matchedCount   Int @default(0) @map("matched_count")
  actionCount    Int @default(0) @map("action_count")

  error String? @db.VarChar(2000)

  rule    Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actions RuleActionLog[]

  @@index([ruleId, startedAt(sort: Desc)])
  @@map("rule_runs")
}

/// Tek bir varlığa dair karar — uygulanan da atlanan da.
///
/// ATLANANLAR DA YAZILIYOR. `outcome` neden atlandığını tek tek söylüyor
/// (bekleme, örneklem, bayat veri, sınır). Tek bir "atlandı" değeri ajansa
/// hiçbir şey anlatmazdı.
///
/// Model adı `RuleActionLog`: `RuleAction` adı paylaşılan pakette AKSİYON
/// TANIMI için kullanılıyor (kuralın ne yapacağı) ve ikisini aynı adla
/// anmak, "kuralın aksiyonu" ile "alınan aksiyon" ayrımını bulanıklaştırırdı.
model RuleActionLog {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  runId  String @map("run_id") @db.Uuid

  entityLevel      EntityLevel @map("entity_level")
  entityId         String      @map("entity_id") @db.Uuid
  /// Ad, varlık silinse bile geçmişte okunabilsin diye KOPYALANIYOR.
  /// Join ile çözmek, silinen bir kampanyanın geçmiş kaydını "—" yapardı.
  entityName       String      @map("entity_name") @db.VarChar(300)
  entityExternalId String      @map("entity_external_id") @db.VarChar(128)

  actionType String @map("action_type") @db.VarChar(20)
  outcome    String @db.VarChar(24)
  /// İnsan okunur gerekçe: "EBM 312,40 > 250 (son 7 gün)".
  reason     String @db.VarChar(500)

  /// Aksiyon öncesi/sonrası durum — geri alma (`rule.revert`) ve denetim için.
  beforeState Json? @map("before_state") @db.JsonB
  afterState  Json? @map("after_state") @db.JsonB

  error String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rule Rule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  run  RuleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Bekleme süresi sorgusu bu indeksi kullanıyor: "bu kural bu varlığa en son
  /// ne zaman DOKUNDU". Atlananlar bekleme başlatmıyor, o filtre sorguda.
  @@index([ruleId, entityId, createdAt(sort: Desc)])
  @@index([runId])
  @@map("rule_action_logs")
}

/// Organik gönderi — Modül 7 Auto-Boost'un girdisi.
///
/// NEDEN AYRI TABLO: bu gönderiler REKLAM DEĞİL. `ads` tablosuna koymak,
/// panelin ve raporun onları reklam sanmasına yol açardı — harcama sıfır,
/// dönüşüm sıfır, ve her ortalama bozulurdu.
///
/// Metrikler `insights_daily`ye de yazılmıyor: o tablo reklam metrikleri için
/// ve organik erişimle ödenmiş erişimi aynı kovaya koymak, müşteriye
/// "reklamla 50 bin kişiye ulaştık" derken 30 bininin organik olduğunu
/// gizlemek olurdu.
model OrganicPost {
  id              String @id @default(uuid()) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  clientId        String @map("client_id") @db.Uuid
  socialProfileId String @map("social_profile_id") @db.Uuid

  externalId   String  @map("external_id") @db.VarChar(128)
  /// photo | video | carousel | reel | text | link
  mediaType    String  @map("media_type") @db.VarChar(20)
  message      String? @db.VarChar(3000)
  /// ADRESLER TEXT, VARCHAR(1024) DEĞİL.
  ///
  /// Meta'nın imzalı medya adresleri uzun ve uzunlukları garanti edilmiyor.
  /// 1024'ü geçen TEK BİR adres, o sayfanın BÜTÜN gönderilerini düşürüyordu:
  /// senkronizasyon tek toplu INSERT kullanıyor ve tek satırın kısıt ihlali
  /// bütün deyimi geri alıyor. Sonuç yine "hiç gönderi yok" olarak görünürdü.
  ///
  /// Kırpmak çözüm değil: kırpılmış bir imzalı adres sessizce kırık görsel
  /// demek. `message` kırpılabiliyor çünkü kırpılmış metin hâlâ metin.
  permalink    String? @db.Text
  thumbnailUrl String? @map("thumbnail_url") @db.Text

  publishedAt DateTime @map("published_at") @db.Timestamptz(6)

  impressions Int @default(0)
  /// Erişim TEKİL kullanıcı — günler arası toplanamaz. Burada zaten gönderi
  /// ömrü boyunca tek bir sayı olarak geliyor, toplama sorusu doğmuyor.
  reach       Int @default(0)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  saves       Int @default(0)
  videoViews  Int @default(0) @map("video_views")
  /// Beğeni + yorum + paylaşım + kaydetme. Platformun kendi "engagement"
  /// alanı tutarsız olduğu için bileşenlerden türetiliyor.
  engagements Int @default(0)

  /// Bu gönderi daha önce boost edildi mi — kural aynı gönderiyi iki kez
  /// boost etmesin diye. `boosts` ilişkisi üzerinden de bulunabilirdi ama
  /// aday sorgusunda her gönderi için alt sorgu çalıştırmak pahalı.
  boostedAt DateTime? @map("boosted_at") @db.Timestamptz(6)

  raw       Json?    @db.JsonB
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  boosts        Boost[]
  draftAds      DraftAd[]

  @@unique([socialProfileId, externalId])
  @@index([clientId, publishedAt(sort: Desc)])
  @@index([socialProfileId, boostedAt])
  @@map("organic_posts")
}

/// Auto-Boost kuralı — Modül 7.
///
/// KURAL MOTORUNDAN (Modül 5) FARKI: orada aksiyon çoğunlukla harcamayı
/// DURDURUYOR, burada harcama BAŞLATIYOR. Asimetri ters yönde ve daha sert:
/// yanlış duraklatılan kampanya yeniden açılır, harcanan para geri gelmez.
///
/// Bu yüzden burada prova modu YETMİYOR — onay akışı var. Aday gönderiler
/// `boost.approve` yetkisi olan biri onaylayana kadar bekliyor. `autoApprove`
/// açıkça açılabiliyor ama varsayılan kapalı.
model BoostRule {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @map("org_id") @db.Uuid
  clientId        String  @map("client_id") @db.Uuid
  /// null = müşterinin tüm sosyal profilleri.
  socialProfileId String? @map("social_profile_id") @db.Uuid

  name        String  @db.VarChar(160)
  description String? @db.VarChar(1000)

  /// [{ metric, operator, value }] — organik metrikler üzerinde.
  conditions Json   @db.JsonB
  combinator String @default("and") @db.VarChar(3)

  /// Gönderi en fazla bu kadar eski olabilir.
  ///
  /// Boost'un işe yaraması için gönderinin hâlâ ilgi görüyor olması gerekiyor;
  /// üç ay önceki bir gönderiyi boost etmek parayı ölü içeriğe harcamak.
  maxPostAgeHours Int @default(72) @map("max_post_age_hours")
  /// Gönderi en az bu kadar yayında kalmış olmalı — ilk saatlerdeki etkileşim
  /// gönderinin gerçek performansını temsil etmiyor.
  minPostAgeHours Int @default(6) @map("min_post_age_hours")

  /// Boost başına GÜNLÜK bütçe (micros) ve süre.
  dailyBudgetMicros BigInt @map("daily_budget_micros")
  durationDays      Int    @default(3) @map("duration_days")

  /// Meta kampanya hedefi. Boost için pratikte POST_ENGAGEMENT ya da
  /// OUTCOME_ENGAGEMENT.
  objective String @default("OUTCOME_ENGAGEMENT") @db.VarChar(60)

  /// AYLIK SERT TAVAN — bu kuralın bir ayda taahhüt edebileceği azami tutar.
  ///
  /// `monthly_budgets`ten AYRI ve ona EK. Aylık bütçe tüm harcamanın tavanı;
  /// bu ise otomatik boost'un o bütçe içindeki payının tavanı. İkisini
  /// birleştirmek, tek bir yanlış eşiğin aylık bütçenin tamamını boost'a
  /// yönlendirmesine izin vermek olurdu.
  monthlyCapMicros BigInt @map("monthly_cap_micros")

  /// Tek turda en fazla kaç aday üretilir.
  maxBoostsPerRun Int @default(3) @map("max_boosts_per_run")

  /// ONAY GEREKTİRMEDEN oluştursun mu. VARSAYILAN HAYIR.
  ///
  /// Para harcayan bir otomasyonun varsayılan olarak onaysız çalışması,
  /// kullanıcının vermediği bir kararı onun adına vermek olur.
  autoApprove Boolean @default(false) @map("auto_approve")

  enabled Boolean @default(true)

  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile  SocialProfile?  @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  boosts         Boost[]
  draftCampaigns DraftCampaign[]

  @@index([clientId, enabled])
  @@map("boost_rules")
}

/// Tek bir boost — aday, onaylanmış ya da oluşturulmuş.
///
/// ADAYLAR DA SAKLANIYOR. Reddedilen bir adayın kaydı, "kural neden bu
/// gönderiyi seçti" ve "neden reddettik" sorularının cevabı; ayrıca aynı
/// gönderinin tekrar tekrar aday gösterilmesini engelliyor.
model Boost {
  id            String  @id @default(uuid()) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  clientId      String  @map("client_id") @db.Uuid
  /// null = elle oluşturulmuş boost (kural değil kullanıcı seçti).
  boostRuleId   String? @map("boost_rule_id") @db.Uuid
  organicPostId String  @map("organic_post_id") @db.Uuid
  /// Faturalandırma hesabı — SocialProfile.linkedAdAccountId'den geliyor.
  adAccountId   String  @map("ad_account_id") @db.Uuid

  /// candidate | approved | rejected | creating | active | failed
  status String @default("candidate") @db.VarChar(16)

  /// BÜTÇE KİPE GÖRE AYRI KOLONDA — tek kolona iki anlam yüklenmiyor.
  ///
  /// Kural yolu GÜNLÜK düşünüyor: süresiz çalışıyor ve aylık tavanı günlük
  /// bütçe × süre üzerinden hesaplanıyor. Elle boost TOPLAM düşünüyor:
  /// kullanıcı "300 TL, 5 gün" diyor ve merak ettiği şey toplam (K18).
  ///
  /// `boosts_budget_chk` kipe göre TAM BİRİNİ zorunlu kılıyor. Aynı kolona
  /// duruma göre günlük ya da toplam yazmak, kolonu okuyan her sorgunun kipi
  /// de okumasını gerektirirdi — ve unutulduğu gün ortaya çıkan şey beş kat
  /// harcama.
  budgetMode        String  @default("daily") @map("budget_mode") @db.VarChar(10)
  dailyBudgetMicros BigInt? @map("daily_budget_micros")
  totalBudgetMicros BigInt? @map("total_budget_micros")
  durationDays      Int     @map("duration_days")
  objective         String  @db.VarChar(60)

  /// Meta hedefleme nesnesi. NULL = sağlayıcının varsayılanı (ülke geneli),
  /// yani kural yolunun bugünkü davranışı.
  ///
  /// SAKLANIYOR, yalnızca gönderilip unutulmuyor: "bu boost kime gösterildi"
  /// sorusunun cevabı aksi hâlde yalnızca Ads Manager'da olurdu ve beklenmedik
  /// bir sonucun sebebi aranırken ilk bakılacak yer burası.
  targeting Json? @db.JsonB

  /// Ads Manager'da kurulu kayıtlı kitle (K16). `targeting` ile BİRLİKTE
  /// OLAMAZ — kısıt veritabanında.
  ///
  /// NEDEN AYRI KOLON: `targeting` olduğu gibi Meta'ya gidiyor ve bizim
  /// uydurduğumuz bir anahtar oraya sızarsa Meta onu SESSİZCE YOK SAYAR.
  /// Kitlenin gerçek hedefleme nesnesi yayın anında platformdan okunuyor.
  savedAudienceId String? @map("saved_audience_id") @db.VarChar(64)

  /// Kuralın bu gönderiyi neden seçtiği — insan okunur.
  /// Elle boost'ta kullanıcının kendi seçimi yazılıyor.
  reason String @db.VarChar(500)

  /// KULLANICININ SEÇTİĞİ kampanya — var olanın altına eklenecekse (K21).
  ///
  /// `externalCampaignId` İLE BİRLEŞTİRİLEMEZ ve sebebi anlam farkı: burası
  /// NEREYE eklemek İSTEDİĞİMİZ (yayın öncesi, seçim), aşağısı Meta'da NE
  /// OLUŞTUĞU (yayın sonrası, olgu). Aşağıdaki kolonun dolu olması bütün kod
  /// tabanında "bu boost platformda var" demek; oraya önceden yazmak
  /// oluşmamış bir boost'u oluşmuş göstermek olurdu.
  ///
  /// NULL = yeni kampanya aç. En korunaklı varsayılan: unutulduğunda fazladan
  /// bir kampanya doğar (geri dönülebilir), paylaşılan bir kampanyaya
  /// dokunulmaz (geri dönülemez).
  targetCampaignExternalId String? @map("target_campaign_external_id") @db.VarChar(128)

  /// Platformda oluşturulan varlıklar. Boost bir kampanya + ad set + reklam.
  externalCampaignId String? @map("external_campaign_id") @db.VarChar(128)
  externalAdSetId    String? @map("external_ad_set_id") @db.VarChar(128)
  externalAdId       String? @map("external_ad_id") @db.VarChar(128)

  /// Adayla birlikte doğan kampanya taslağı.
  ///
  /// Onaylanan boost platformda oluşunca AYNI satır `published` oluyor —
  /// ikinci bir kampanya doğmuyor. Taslak silinirse bu kolon NULL olur ama
  /// boost kaydı yaşar: `boosts` onay ve tavan muhasebesinin defteri.
  draftCampaignId String? @map("draft_campaign_id") @db.Uuid

  error String? @db.VarChar(1000)

  approvedBy          String?   @map("approved_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)
  createdOnPlatformAt DateTime? @map("created_on_platform_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  boostRule    BoostRule?   @relation(fields: [boostRuleId], references: [id], onDelete: SetNull)
  organicPost  OrganicPost  @relation(fields: [organicPostId], references: [id], onDelete: Cascade)
  adAccount    AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  /// AYNI GÖNDERİ İKİ KEZ BOOST EDİLMESİN.
  ///
  /// Kısmi tekil indeks migration'da: yalnızca "canlı" sayılan durumlar
  /// (aday/onaylı/oluşturuluyor/aktif) çakışıyor. Reddedilmiş ya da başarısız
  /// bir boost yeniden denenebilmeli.
  autoBoostQueueItems AutoBoostQueueItem[]

  @@index([clientId, status, createdAt(sort: Desc)])
  @@index([boostRuleId, createdAt(sort: Desc)])
  @@map("boosts")
}

/// Toplu oluşturma partisi — Modül 8.
///
/// PARTİ VE SATIR AYRI TABLOLARDA. Tek bir JSONB dizisi olarak saklamak
/// cazip ama yanlış: 60 reklamlık bir partide 3'ü başarısız olduğunda
/// hangilerinin platformda oluştuğunu satır bazında bilmek gerekiyor.
/// Diziyi güncellemek, kısmi başarıyı takip edilemez kılardı.
model BulkBatch {
  id          String @id @default(uuid()) @db.Uuid
  orgId       String @map("org_id") @db.Uuid
  clientId    String @map("client_id") @db.Uuid
  adAccountId String @map("ad_account_id") @db.Uuid

  name String @db.VarChar(160)

  /// draft | validated | publishing | published | failed
  status String @default("draft") @db.VarChar(16)

  /// Partinin tamamına uygulanan ayarlar: hedefleme, hedef, bütçe modeli.
  /// Satır bazında değişenler `BulkItem.overrides` içinde.
  defaults Json @db.JsonB

  /// Mevcut bir kampanyaya mı ekleniyor, yoksa yenisi mi açılıyor.
  ///
  /// Var olan kampanyaya eklemek en yaygın kullanım: ajans zaten kurulu bir
  /// yapıya 40 varyasyon ekliyor. Kampanya kimliği boşsa yeni açılıyor.
  targetCampaignExternalId String? @map("target_campaign_external_id") @db.VarChar(128)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String?   @map("published_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount    AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  items        BulkItem[]

  @@index([clientId, createdAt(sort: Desc)])
  @@map("bulk_batches")
}

/// Partideki tek bir reklam.
model BulkItem {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @map("org_id") @db.Uuid
  batchId String @map("batch_id") @db.Uuid

  /// Satır numarası — kullanıcının yapıştırdığı tablodaki sıra.
  /// Hata mesajlarında "3. satır" demek için gerekli.
  rowNumber Int @map("row_number")

  name         String  @db.VarChar(300)
  /// KOLONLAR PLATFORM SINIRINDAN GENİŞ ve bu bilinçli.
  ///
  /// Sınırı aşan metin REDDEDİLMİYOR, SAKLANIYOR — doğrulayıcı onu
  /// "45 karakter fazla" diye işaretliyor ve kullanıcı düzeltebiliyor.
  /// Kolonu tam sınırda tutmak, geçersiz satırı hiç kaydedememek demekti:
  /// kullanıcı satır bazında bir uyarı yerine tüm parti için anlaşılmaz bir
  /// veritabanı hatası alırdı.
  primaryText  String? @map("primary_text") @db.VarChar(8000)
  headline     String? @db.VarChar(2000)
  description  String? @db.VarChar(2000)
  linkUrl      String? @map("link_url") @db.VarChar(2048)
  callToAction String? @map("call_to_action") @db.VarChar(60)
  /// Görsel/video kimliği ya da URL'si. Yükleme AYRI bir adım.
  /// Arşivdeki görselin ADI — kullanıcının yazdığı hâliyle.
  ///
  /// Eşleşmediğinde hata mesajında gösteriliyor; yalnızca `assetId` tutmak
  /// "hangi ad yanlıştı" sorusunu cevapsız bırakırdı.
  assetName    String? @map("asset_name") @db.VarChar(200)
  /// Çözümlenmiş varlık. Doğrulama anında sabitleniyor; sonraki bir yeniden
  /// adlandırma partiyi bozmuyor.
  assetId      String? @map("asset_id") @db.Uuid

  mediaRef String? @map("media_ref") @db.VarChar(1024)

  /// Bu satıra özel ayarlar — partinin `defaults` değerlerini eziyor.
  overrides Json? @db.JsonB

  /// pending | invalid | publishing | published | failed
  status String @default("pending") @db.VarChar(16)

  /// Doğrulama hataları — satır bazında, insan okunur.
  ///
  /// DİZİ, tek bir string değil: bir satırda birden fazla sorun olabiliyor
  /// ve kullanıcıya hepsini birden göstermek, düzeltip yeniden denemeyi
  /// tek turda bitiriyor.
  issues Json? @db.JsonB

  externalAdId       String? @map("external_ad_id") @db.VarChar(128)
  externalCreativeId String? @map("external_creative_id") @db.VarChar(128)
  externalAdSetId    String? @map("external_ad_set_id") @db.VarChar(128)
  error              String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  batch BulkBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("bulk_items")
}

/// Reklam taslağı — Modül 4 (CREATE), Reklam Oluşturucu.
///
/// TOPLU OLUŞTURUCUDAN (bulk_batches) AYRI. İkisi de reklam üretiyor ama
/// farklı işler: toplu oluşturucu deneyimli kullanıcı için, elektronik tablo
/// mantığında, onlarca satır. Bu ise reklamcılık bilmeyen biri için, tek
/// reklam, adım adım.
///
/// Tek tabloda birleştirmek her ikisinin de doğrulamasını bozardı: toplu
/// oluşturucu satır satır hata veriyor ve kısmi başarıyı yönetiyor, burada
/// ise tek bir sonuç var — yayınlandı ya da yayınlanmadı.
model AdDraft {
  id              String @id @default(uuid()) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  clientId        String @map("client_id") @db.Uuid
  adAccountId     String @map("ad_account_id") @db.Uuid
  /// Reklamın yayınlanacağı Facebook sayfası.
  socialProfileId String @map("social_profile_id") @db.Uuid

  /// form | whatsapp | website — kullanıcının verdiği TEK stratejik karar.
  goal String @db.VarChar(16)
  name String @db.VarChar(200)

  /// simple | advanced — "tek giriş, iki mod".
  ///
  /// Hızlı modda Meta'nın sorduğu her şeye biz cevap veriyoruz
  /// (`goal-mapping.ts`). Gelişmiş modda kullanıcının seçimleri `advanced`
  /// içinde duruyor ve AYNI doğrulamadan, AYNI yayın yolundan geçiyor.
  mode String @default("simple") @db.VarChar(10)

  /// Gelişmiş ayarlar. JSONB çünkü alanlar Meta'nın alanları ve Meta bunları
  /// sürümden sürüme değiştiriyor — otuz kolon her değişiklikte migration
  /// demek olurdu.
  advanced Json? @db.JsonB

  /// Kütüphaneden seçilen anlık form (yalnızca gelişmiş mod).
  ///
  /// Hızlı modda form taslakla birlikte oluşturuluyor ve ömrü ona bağlı;
  /// burada kütüphaneden seçiliyor ve birden çok reklamda kullanılabiliyor.
  leadFormId String? @map("lead_form_id") @db.Uuid

  primaryText String  @map("primary_text") @db.VarChar(2000)
  headline    String? @db.VarChar(255)
  description String? @db.VarChar(255)

  /// website tipi için.
  linkUrl        String? @map("link_url") @db.VarChar(2048)
  /// whatsapp tipi için. Boşsa sayfaya bağlı numara kullanılıyor.
  whatsappNumber String? @map("whatsapp_number") @db.VarChar(20)

  dailyBudgetMicros BigInt @map("daily_budget_micros")
  /// 0 = süresiz.
  durationDays      Int    @default(7) @map("duration_days")

  /// draft | publishing | published | failed
  status String @default("draft") @db.VarChar(16)

  externalCampaignId String? @map("external_campaign_id") @db.VarChar(128)
  externalAdSetId    String? @map("external_ad_set_id") @db.VarChar(128)
  externalCreativeId String? @map("external_creative_id") @db.VarChar(128)
  externalAdId       String? @map("external_ad_id") @db.VarChar(128)
  /// Anlık form tipinde Meta'da oluşturulan formun kimliği.
  externalLeadFormId String? @map("external_lead_form_id") @db.VarChar(128)

  error       String?   @db.VarChar(2000)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount     AdAccount      @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile  @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  leadForm      LeadForm?      @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  assets        AdDraftAsset[]

  @@index([clientId, createdAt(sort: Desc)])
  @@map("ad_drafts")
}

/// Taslağa yüklenen görsel.
///
/// DOSYA DİSKTE, VERİTABANINDA DEĞİL. 30 MB'a kadar görselleri JSONB ya da
/// bytea olarak saklamak yedekleri şişirir ve her sorguyu yavaşlatır.
/// `storageKey` diskteki yolu işaret ediyor.
model AdDraftAsset {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @map("org_id") @db.Uuid
  draftId String @map("draft_id") @db.Uuid

  /// square | vertical | horizontal
  ratio String @db.VarChar(12)

  fileName String @map("file_name") @db.VarChar(300)
  mimeType String @map("mime_type") @db.VarChar(60)
  byteSize Int    @map("byte_size")
  width    Int
  height   Int

  /// Disk üzerindeki göreli yol. Kök dizin yapılandırmadan geliyor.
  storageKey String @map("storage_key") @db.VarChar(500)

  /// Meta'ya yüklendikten sonra dönen hash.
  ///
  /// YAYINDA DOLUYOR, yüklemede değil: her yüklemede Meta'ya da göndermek,
  /// yayınlanmayan taslaklar için boşuna kota harcamak olurdu.
  metaImageHash String? @map("meta_image_hash") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Kütüphanedeki kaynağı. NULL = kütüphane öncesi yüklenmiş ya da
  /// doğrudan taslağa bırakılmış.
  assetId String? @map("asset_id") @db.Uuid

  draft AdDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  asset Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Oran başına TEK görsel. İkinci kare görsel yüklemek öncekini
  /// değiştirmeli, yanına eklenmemeli — arayüzde de üç kutu var.
  @@unique([draftId, ratio])
  @@map("ad_draft_assets")
}

/// Anahtar kelime performansı — YALNIZCA GOOGLE.
///
/// NEDEN AYRI TABLO, `insights_daily`de bir seviye değil:
///
///   · Anahtar kelime reklam hiyerarşisinin bir parçası DEĞİL. Kampanya →
///     ad group → reklam zinciri varlıkları temsil ediyor; anahtar kelime bir
///     HEDEFLEME KRİTERİ ve `ads` tablosunda karşılığı yok.
///
///   · `entity_level` enum'una 'keyword' eklemek, o enum üzerinde çalışan her
///     sorguyu etkilerdi. Panel toplamları tek seviyeden okuyor
///     (TOTALS_LEVEL='campaign'); yeni bir seviye eklemek çift sayım riskini
///     her sorguya taşırdı.
///
///   · Meta'da karşılığı YOK. `insights_daily` iki platformu birleştiriyor;
///     yalnızca birinde var olan bir seviye o tabloyu asimetrik yapardı.
/// Arama terimleri — kullanıcının gerçekten YAZDIĞI sorgular.
///
/// Anahtar kelime bizim hedeflediğimiz şey; arama terimi kullanıcının
/// yazdığı şey. Fark tam olarak paranın nereye gittiğini gösteriyor: geniş
/// eşlemeli bir kelime hiç istemediğimiz sorgulara da gösterim alabiliyor.
model SearchTermInsight {
  clientId    String  @map("client_id") @db.Uuid
  adAccountId String  @map("ad_account_id") @db.Uuid
  adGroupId   String? @map("ad_group_id") @db.Uuid

  /// Terimin SHA-256'sı. Arama teriminin sabit bir kimliği yok ve metnin
  /// kendisini birincil anahtara koymak btree anahtar sınırına (~2704 bayt)
  /// yaklaşıyor; yazma anındaki bir indeks hatası gece koşan bir işin
  /// sessizce düşmesi demek olurdu.
  termHash    String  @map("term_hash") @db.Char(64)
  searchTerm  String  @map("search_term") @db.VarChar(500)
  /// Terimi getiren anahtar kelime — "hangi kelime bu sorguyu çekti".
  keywordText String? @map("keyword_text") @db.VarChar(500)
  matchType   String? @map("match_type") @db.VarChar(20)

  /// ADDED | EXCLUDED | ADDED_EXCLUDED | NONE
  ///
  /// ÜRÜN AÇISINDAN EN DEĞERLİ ALAN: `NONE` olan bir terim para harcıyor ama
  /// ne anahtar kelime ne de negatif olarak tanımlı.
  status String @default("NONE") @db.VarChar(20)

  date DateTime @db.Date

  impressions           Int     @default(0)
  clicks                Int     @default(0)
  spendMicros           BigInt  @default(0) @map("spend_micros")
  conversions           Decimal @default(0) @db.Decimal(14, 4)
  conversionValueMicros BigInt  @default(0) @map("conversion_value_micros")

  currency  String   @db.Char(3)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@id([date, adAccountId, termHash])
  @@index([clientId, date(sort: Desc)])
  @@index([adAccountId, date(sort: Desc)])
  @@map("search_term_insights")
}

/// ═══ KIRILIM METRİKLERİ — YAŞ, CİNSİYET, YERLEŞİM, SAAT, ŞEHİR ═══
///
/// `insights_daily`YE YAZILMIYOR ve bu kararın tamamı burada. O tablonun
/// birincil anahtarı `breakdown_key` taşıyor, yani kırılım satırları oraya
/// TEKNİK OLARAK sığıyor — ama mevcut toplama sorgularının HİÇBİRİ
/// `breakdown_key`i süzmüyor. Kırılım satırları oraya yazıldığı an her
/// harcama rakamı kırılım sayısı kadar KATLANIR ve hiçbir hata düşmez;
/// panel yalnızca yanlış sayı gösterir. `keyword_insights` ve
/// `search_term_insights` de aynı sebeple ayrı tablolar.
///
/// TEK TABLO, TÜR KOLONU İLE. Yaş, cinsiyet, şehir için ayrı tablolar açmak
/// beş migration, beş RLS politikası ve beş senkronizasyon yolu demekti;
/// hepsi aynı şekle sahip (boyut → değer → metrikler).
model InsightBreakdown {
  clientId    String @map("client_id") @db.Uuid
  adAccountId String @map("ad_account_id") @db.Uuid
  platform    Platform

  /// Hangi kırılım — `age`, `gender`, `placement`, `hour`, `city`.
  dimension BreakdownDimension

  /// Kırılımın DEĞERİ, platformdan geldiği gibi ("25-34", "female",
  /// "instagram_stories", "14", "İzmir").
  ///
  /// NORMALİZE EDİLMİYOR. Meta "female", Google "FEMALE" diyor ve ikisini
  /// tek dile çevirmek gibi bir istek var — ama çeviri KAYIPLI: Meta
  /// "unknown" kovası taşıyor, Google "UNDETERMINED" ve ikisi aynı şey
  /// değil. Ham değer saklanıp GÖSTERİMDE çevriliyor; ters yönde bir
  /// hatayı geri almak imkânsız olurdu.
  value String @db.VarChar(120)

  date DateTime @db.Date

  impressions           Int     @default(0)
  clicks                Int     @default(0)
  spendMicros           BigInt  @default(0) @map("spend_micros")
  conversions           Decimal @default(0) @db.Decimal(14, 4)
  conversionValueMicros BigInt  @default(0) @map("conversion_value_micros")

  currency  String   @db.Char(3)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  /// HESAP SEVİYESİNDE TOPLANMIŞ, kampanya seviyesinde DEĞİL.
  ///
  /// Kampanya × kırılım × gün, hacmi bir mertebe büyütüyor ve rapor zaten
  /// hesap toplamını gösteriyor ("müşterinin kitlesi kim"). Kampanya bazlı
  /// kırılım istenirse ayrı bir karar ve ayrı bir kota konuşması.
  @@id([date, adAccountId, dimension, value])
  @@index([clientId, date(sort: Desc)])
  @@index([adAccountId, dimension, date(sort: Desc)])
  @@map("insight_breakdowns")
}

/// Kırılım boyutları.
///
/// İLGİ ALANI YOK ve bu bilinçli: Meta'nın Ads Insights API'sinde ilgi
/// alanı kırılımı BULUNMUYOR — ilgi alanı bir hedefleme girdisi, raporlanan
/// bir boyut değil. Google tarafında yalnızca hedefleme kriteri olarak
/// eklenmiş kitleler için kısmi veri var. Tek platformda yarım çalışan bir
/// boyut, raporda "Meta'da neden boş" sorusunu doğurur; olmayan bir kovayı
/// uydurmak ise boş tablodan kötü.
enum BreakdownDimension {
  age
  gender
  /// Meta: publisher_platform + platform_position. Google: ad_network_type.
  placement
  /// Reklam hesabının KENDİ zaman diliminde 0-23.
  hour
  city
}

model KeywordInsight {
  clientId    String  @map("client_id") @db.Uuid
  adAccountId String  @map("ad_account_id") @db.Uuid
  /// Bizim ad group kimliğimiz — yapı senkronizasyonu eşleştiriyor.
  /// Eşleşme bulunamazsa null: anahtar kelime verisini atmak yerine
  /// bağlamsız saklamak daha iyi.
  adGroupId   String? @map("ad_group_id") @db.Uuid

  /// Google'ın criterion kimliği. Anahtar kelime METNİ değişebiliyor
  /// (eşleme türü düzenlemesi); kimlik sabit ve doğru tekillik anahtarı bu.
  externalCriterionId String @map("external_criterion_id") @db.VarChar(64)

  keyword   String @db.VarChar(500)
  /// EXACT | PHRASE | BROAD
  matchType String @map("match_type") @db.VarChar(20)

  date DateTime @db.Date

  impressions           Int     @default(0)
  clicks                Int     @default(0)
  spendMicros           BigInt  @default(0) @map("spend_micros")
  conversions           Decimal @default(0) @db.Decimal(14, 4)
  conversionValueMicros BigInt  @default(0) @map("conversion_value_micros")

  currency  String   @db.Char(3)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  /// PARTITION YOK — `insights_daily`den farklı.
  ///
  /// O tablo dört seviyeyi × her gün × her varlık tutuyor ve hızla milyonlara
  /// çıkıyor. Anahtar kelime yalnızca Google'da, yalnızca arama
  /// kampanyalarında ve yalnızca gösterim ALAN kelimeler için yazılıyor.
  /// Hacim bir mertebe küçük; partition karmaşıklığı henüz karşılığını
  /// vermiyor.
  @@id([date, adAccountId, externalCriterionId])
  @@index([clientId, date(sort: Desc)])
  @@index([adAccountId, date(sort: Desc)])
  @@map("keyword_insights")
}

model SyncJob {
  id       BigInt @id @default(autoincrement())
  clientId String @map("client_id") @db.Uuid

  adAccountId     String? @map("ad_account_id") @db.Uuid
  socialProfileId String? @map("social_profile_id") @db.Uuid

  jobType     SyncJobType  @map("job_type")
  entityLevel EntityLevel? @map("entity_level")
  dateFrom    DateTime?    @map("date_from") @db.Date
  dateTo      DateTime?    @map("date_to") @db.Date

  status   SyncJobStatus @default(queued)
  /// 1 = kullanıcı tetiklemeli (interaktif) … 10 = backfill. Düşük sayı önce.
  priority Int           @default(5)

  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")

  apiCallsUsed Int @default(0) @map("api_calls_used")
  rowsUpserted Int @default(0) @map("rows_upserted")

  /// Yazılamayıp ATILAN satır sayısı. NULL = bilinmiyor (kolon öncesi kayıt);
  /// 0 ile aynı şey DEĞİL. `rows_upserted = 0` ve `rows_skipped > 0` olan bir
  /// iş "başarılı" görünür ama hiçbir veri yazmamıştır.
  rowsSkipped Int?    @map("rows_skipped")
  /// İnsan okuması için özet: hangi aralık, hangi seviye, kaç satır, kaç
  /// atlandı. Bugüne kadar yalnızca worker log'una yazılıyordu.
  note        String? @db.VarChar(500)

  /// Meta async insights job kimliği — worker yeniden başlasa bile polling sürer.
  platformJobId String? @map("platform_job_id") @db.VarChar(255)
  /// BullMQ iş kimliği — kuyruktaki işle veritabanı kaydını eşleştirir.
  queueJobId    String? @map("queue_job_id") @db.VarChar(255)

  errorCode    String? @map("error_code") @db.VarChar(80)
  errorMessage String? @map("error_message") @db.VarChar(1000)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([status, nextRetryAt])
  @@index([adAccountId, jobType, createdAt(sort: Desc)])
  @@map("sync_jobs")
}

/// API kota tüketimi — adaptif hız sınırlayıcının gözü.
///
/// Meta kotayı `X-Business-Use-Case-Usage` header'ında ÜÇ yüzde olarak veriyor;
/// Google hiç vermiyor, yalnızca tükendiğinde hata döndürüyor. Bu tablo ikisini
/// aynı yerde tutuyor ve "hangi müşteri kotayı yiyor" sorusunu cevaplıyor.
model ApiUsageLog {
  id          BigInt   @id @default(autoincrement())
  platform    Platform
  clientId    String?  @map("client_id") @db.Uuid
  adAccountId String?  @map("ad_account_id") @db.Uuid

  endpoint String @db.VarChar(255)

  /// Meta BUC yüzdeleri.
  callCountPct   Int? @map("call_count_pct")
  cpuTimePct     Int? @map("cpu_time_pct")
  totalTimePct   Int? @map("total_time_pct")
  /// Üçünün en yükseği — adaptif eşikler bunu okuyor.
  usagePercent   Int? @map("usage_percent")
  /// Google: bu istekte tüketilen operasyon sayısı.
  operationsUsed Int? @map("operations_used")

  httpStatus Int?    @map("http_status")
  errorCode  String? @map("error_code") @db.VarChar(80)
  latencyMs  Int?    @map("latency_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adAccountId, createdAt(sort: Desc)])
  @@index([platform, createdAt(sort: Desc)])
  @@map("api_usage_log")
}

/// Meta Anlık Form (Instant Form) — Kütüphane > Formlar.
///
/// YAYINLANMIŞ FORM DEĞİŞTİRİLEMİYOR. Meta güncellemeyi kabul etmiyor çünkü
/// kullanıcılar belirli bir onay metnini kabul ederek veri verdi. "Düzenleme"
/// bu yüzden YENİ BİR SATIR üretiyor; eski satır topladığı bilgilerle duruyor.
model LeadForm {
  id              String @id @default(uuid()) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  clientId        String @map("client_id") @db.Uuid
  /// Form SAYFAYA ait, reklam hesabına değil. Meta'da `leadgen_forms` uç
  /// noktası sayfanın altında yaşıyor ve sayfa token'ı gerektiriyor.
  socialProfileId String @map("social_profile_id") @db.Uuid

  /// Yalnızca panelde görünüyor; Meta'ya gitmiyor, müşteri görmüyor.
  name     String @db.VarChar(200)
  /// more_volume | higher_intent | rich_form
  formType String @default("more_volume") @map("form_type") @db.VarChar(16)

  headline String? @db.VarChar(60)
  intro    String? @db.VarChar(1000)

  prefillQuestions Json @map("prefill_questions") @db.JsonB
  customQuestions  Json @default("[]") @map("custom_questions") @db.JsonB

  privacyPolicyUrl      String @map("privacy_policy_url") @db.VarChar(2048)
  privacyPolicyLinkText String @default("Gizlilik Politikası") @map("privacy_policy_link_text") @db.VarChar(80)
  /// KVKK açık rıza kutuları. Meta'nın `custom_disclaimer` yapısına çevriliyor.
  consentBoxes          Json   @default("[]") @map("consent_boxes") @db.JsonB

  thankYouHeadline String  @default("Teşekkürler!") @map("thank_you_headline") @db.VarChar(60)
  thankYouBody     String  @default("") @map("thank_you_body") @db.VarChar(300)
  thankYouCtaText  String  @default("") @map("thank_you_cta_text") @db.VarChar(40)
  thankYouCtaUrl   String? @map("thank_you_cta_url") @db.VarChar(2048)

  /// draft | published | superseded | failed
  status         String  @default("draft") @db.VarChar(16)
  externalFormId String? @map("external_form_id") @db.VarChar(128)

  version        Int     @default(1)
  /// Zincirin ilk halkası. İLK SÜRÜMDE KENDİ KİMLİĞİ — NULL değil.
  rootId         String  @map("root_id") @db.Uuid
  /// Bu formu geçersiz kılan yeni sürüm. İleriye bakıyor.
  supersededById String? @map("superseded_by_id") @db.Uuid

  error       String?   @db.VarChar(2000)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  root          LeadForm       @relation("LeadFormRoot", fields: [rootId], references: [id], onDelete: Cascade)
  versions      LeadForm[]     @relation("LeadFormRoot")
  supersededBy  LeadForm?      @relation("LeadFormSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes    LeadForm[]     @relation("LeadFormSupersede")
  adDrafts      AdDraft[]
  draftAdGroups DraftAdGroup[]
  leads         Lead[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([rootId, version])
  @@map("lead_forms")
}

/// Potansiyel müşteri — Meta anlık formundan gelen kayıt.
///
/// KAÇAN KAYIT SESSİZDİR: reklam yayında, bütçe harcanıyor, form
/// dolduruluyor ama kayıt ulaşmazsa hiçbir yerde hata görünmüyor. Bu yüzden
/// iki ayrı yol var (webhook + mutabakat taraması) ve `source` hangisinden
/// geldiğini kaydediyor.
model Lead {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// Meta'daki kayıt kimliği — mükerrer engelinin dayanağı.
  externalLeadId String @map("external_lead_id") @db.VarChar(64)

  leadFormId      String? @map("lead_form_id") @db.Uuid
  socialProfileId String? @map("social_profile_id") @db.Uuid

  externalAdId String? @map("external_ad_id") @db.VarChar(64)
  /// KOPYALANIYOR, join'le çözülmüyor: reklam silinirse atıf kaybolur ve
  /// geçmiş rapor değişirdi.
  campaignName String? @map("campaign_name") @db.VarChar(300)
  leadFormName String? @map("lead_form_name") @db.VarChar(300)

  /// Aranabilir alanlar ayrı kolonda — JSONB içinde arama indekslenemiyor.
  fullName String? @map("full_name") @db.VarChar(300)
  email    String? @db.VarChar(320)
  phone    String? @db.VarChar(40)
  fields   Json    @default("[]") @db.JsonB

  status String  @default("new") @db.VarChar(16)
  note   String? @db.VarChar(2000)
  /// webhook | reconcile | manual — TEŞHİS İÇİN.
  source String  @db.VarChar(16)

  /// Meta'da formun doldurulduğu an. `createdAt` bizim aldığımız an.
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadForm      LeadForm?      @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  socialProfile SocialProfile? @relation(fields: [socialProfileId], references: [id], onDelete: SetNull)

  @@unique([externalLeadId], map: "leads_external_uniq")
  @@index([clientId, submittedAt(sort: Desc)])
  @@index([clientId, status])
  @@index([leadFormId])
  @@map("leads")
}

/// Mutabakat imleci — form başına "nereye kadar okuduk".
///
/// İMLEÇ `lead_forms` İÇİNDE DEĞİL: o tablo sürüm zinciriyle yönetiliyor ve
/// her düzenleme yeni satır üretiyor. İmleç Meta'nın form kimliğine bağlı,
/// bizimkine değil.
model LeadSyncCursor {
  id              String @id @default(uuid()) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  clientId        String @map("client_id") @db.Uuid
  socialProfileId String @map("social_profile_id") @db.Uuid
  externalFormId  String @map("external_form_id") @db.VarChar(64)

  syncedThrough DateTime? @map("synced_through") @db.Timestamptz(6)
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error") @db.VarChar(1000)
  /// Son taramada bulunan YENİ kayıt sayısı. Sürekli sıfırdan büyükse
  /// webhook o sayfa için çalışmıyor demektir.
  lastNewCount  Int       @default(0) @map("last_new_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@unique([externalFormId], map: "lead_sync_cursors_form_uniq")
  @@map("lead_sync_cursors")
}

/// Varlık arşivi (BASE) — müşteri bazlı görsel kütüphanesi.
///
/// Dosya BİR KEZ yükleniyor ve birden çok kampanyada kullanılıyor. Bugüne
/// kadar her görsel bir taslağa bağlıydı; aynı ürün fotoğrafını ikinci bir
/// kampanyada kullanmak yeniden yüklemek demekti.
model Asset {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// image | logo
  ///
  /// Logo ayrı bir tür: markaya ait, kampanyadan kampanyaya değişmiyor ve
  /// Google Performance Max onsuz kampanya oluşturmuyor.
  kind String @default("image") @db.VarChar(12)

  name     String @db.VarChar(200)
  fileName String @map("file_name") @db.VarChar(300)
  mimeType String @map("mime_type") @db.VarChar(60)
  byteSize Int    @map("byte_size")
  width    Int
  height   Int

  storageKey String @map("storage_key") @db.VarChar(500)

  /// İçerik özeti — mükerrer yüklemeyi engelliyor. MÜŞTERİ BAZLI tekil.
  contentHash String @map("content_hash") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platformRefs  AssetPlatformRef[]
  draftAssets   AdDraftAsset[]
  bulkItems     BulkItem[]
  creativeLinks AdCreativeAsset[]

  @@unique([clientId, contentHash], map: "assets_client_hash_uniq")
  @@index([clientId, kind, createdAt(sort: Desc)])
  @@map("assets")
}

/// Varlığın bir reklam hesabındaki karşılığı.
///
/// META HASH'İ HESAP BAŞINA. Aynı görsel iki hesapta kullanılıyorsa iki ayrı
/// hash var; tek kolonda tutmak A hesabının hash'ini B hesabında kullanmak
/// demek ve Meta bunu ya reddediyor ya da kreatifi görselsiz oluşturuyor.
model AssetPlatformRef {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  platform    Platform
  adAccountId String   @map("ad_account_id") @db.Uuid
  /// Meta'da `image_hash`, Google'da varlık kaynak adı.
  externalRef String   @map("external_ref") @db.VarChar(256)
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  adAccount    AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([assetId, adAccountId], map: "asset_platform_refs_uniq")
  @@map("asset_platform_refs")
}

/// Kreatif — metin havuzu + görsel havuzu.
///
/// META İLE GOOGLE'IN BİRLEŞTİĞİ YER. Kampanya, ad set ve yayın çağrısı
/// platforma özgü kalıyor; birleşen tek şey kreatif. Sebebi iki platformun
/// metin isteğinin aynı şey olmaması: Meta bir başlık alıyor, Google RSA
/// on beşe kadar.
///
/// NEDEN `ad_drafts` SÜTUNLARI YETMİYOR: metinler bugün o tablonun üç
/// sütununda duruyor (`primary_text`, `headline`, `description`) ve on beş
/// başlık üç sütuna sığmıyor. Her platform için ayrı sütun açmak ise aynı
/// cümlenin iki yerde durması demek — biri düzeltilir, diğeri unutulur ve
/// fark yalnızca yayına çıkan reklamda görülür.
///
/// TASLAĞA BAĞLI DEĞİL, MÜŞTERİYE AİT. `ad_draft_assets` bir taslağa çiviliydi
/// ve aynı kreatifi ikinci bir kampanyada kullanmanın yolu yoktu. Kreatif
/// kendi başına durunca "geçen ayki reklamı tekrarla" mümkün oluyor.
model AdCreative {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  name String @db.VarChar(200)

  /// Metin havuzu — `creativeTextsSchema` (packages/shared).
  ///
  /// JSONB ÇÜNKÜ SAYILAR PLATFORMUN. Google RSA bugün 15 başlık istiyor,
  /// yarın 12 isteyebilir; PMax'in kısa/uzun başlık dağılımı sürümle
  /// değişiyor. Her parçaya bir sütun açmak, platformun her kararında
  /// migration demek olurdu. Aynı gerekçe `ad_drafts.advanced` için de
  /// geçerliydi.
  ///
  /// Havuz PLATFORMDAN BAĞIMSIZ: hangi metnin nereye gideceğine
  /// `packTextsFor` karar veriyor ve sığmayanı sebebiyle eliyor.
  texts Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets       AdCreativeAsset[]
  draftAds     DraftAd[]

  @@index([clientId, createdAt(sort: Desc)])
  @@map("ad_creatives")
}

/// Kreatif ↔ arşiv görseli.
///
/// GÖRSEL KOPYALANMIYOR, BAĞLANIYOR. Arşivin varlık sebebi bu: bir görselin
/// on kreatifte kullanılması on kopya demek olmamalı.
///
/// ORAN BURADA TUTULMUYOR ve bu bilinçli. `ad_draft_assets` her satırda bir
/// `ratio` taşıyordu (square/vertical/horizontal) çünkü o kovalar Meta'nın
/// kovalarıydı. Google başka oranlar istiyor (1.91:1, 4:5) ve aynı görsel iki
/// platformda iki farklı yuvaya düşebiliyor — oranı satıra yazmak, kreatifi
/// bir platforma bağlamak olurdu. Hangi görselin hangi yerleşime gittiğini
/// `coverageFor` ölçülen boyutlardan hesaplıyor ve iki platformu da biliyor.
model AdCreativeAsset {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  creativeId String @map("creative_id") @db.Uuid
  assetId    String @map("asset_id") @db.Uuid

  /// Sıra SABİT tutuluyor: veritabanı sırası rastgele ve görsellerin arayüzde
  /// yer değiştirmesi kafa karıştırırdı. `ad_drafts` bunu kod tarafında
  /// sıralayarak çözüyordu; burada veriye yazılıyor çünkü sıra artık
  /// kullanıcının kararı.
  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creative     AdCreative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// AYNI GÖRSEL BİR KREATİFE İKİ KEZ EKLENEMEZ. Meta aynı görseli iki kez
  /// içeren bir kreatifi kabul ediyor ve ikinci kopyayı sessizce yok sayıyor;
  /// kullanıcı ise iki farklı görsel yüklediğini sanıyor.
  @@unique([creativeId, assetId], map: "ad_creative_assets_uniq")
  @@index([assetId])
  @@map("ad_creative_assets")
}

// -----------------------------------------------------------------------------
// Kampanya taslağı ağacı
//
// ADLANDIRMA SENKRONİZE OKUMA TARAFINI AYNALIYOR:
//   campaigns  → ad_groups  → ads          (platformdan gelen, okunan)
//   draft_campaigns → draft_ad_groups → draft_ads   (bizim kurduğumuz, yazılacak)
//
// "ad set" değil `ad_group` çünkü okuma tarafı da öyle: aynı tablo hem Meta ad
// set'ini hem Google ad group'unu tutuyor ve iki ayrı kelime kullanmak, aynı
// şeyin iki adı olması demek olurdu. Panelde kullanıcı yine "reklam grubu"
// görecek; buradaki isim veritabanının işi.
//
// Ayna kasıtlı: taslak yayınlandığında bu ağaç senkronize satırlara bağlanıyor
// ve "yayınladığım şey şu anda ne durumda" sorusu tek eşlemeyle cevaplanıyor.
// -----------------------------------------------------------------------------

/// Kampanya taslağı — BİR TASLAK = BİR PLATFORM.
///
/// Aynı niyetin iki platformdaki karşılığı `groupId` ile bağlanıyor, tek satırda
/// birleştirilmiyor. Sebebi kısmi başarı: Meta çıkar, Google düşer ve bu
/// istisna değil normal sonuçtur — iki API, iki onay süreci, iki politika
/// motoru. Tek `status` alanı iki gerçeği taşıyamıyor; "başarısız" demek
/// yayındaki Meta reklamını gizler, "yayında" demek hiç oluşmamış Google
/// kampanyasını var gösterir. İkisi de bu projenin klasik sessiz hatası.
///
/// İkinci gerekçe bütçe: "günde 200 ₺" iki platforma nasıl bölünecek sorusunun
/// cevabı kullanıcının kararı. Ayrı satır = ayrı bütçe, açıkça.
///
/// `ad_drafts` TABLOSU YERİNDE DURUYOR ve çalışmaya devam ediyor. Bu ağaç onun
/// yerini alacak ama göç ayrı bir iş (tasarım belgesi K11) — şimdilik ikisi yan
/// yana ve hiçbir mevcut satır taşınmadı.
model DraftCampaign {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// Aynı niyetin diğer platformdaki eşi. NULL = tek platformluk taslak.
  ///
  /// KENDİ TABLOSU YOK ve bu bilinçli: grubun kampanya adından başka özniteliği
  /// olmayacak, tablo açmak boş bir satır tutmak demek olurdu. Raporlamada
  /// "bu kampanyanın toplam sonucu" bu kimlik üzerinden kuruluyor — ama
  /// TOPLANAMAYAN METRİK TOPLANMIYOR: erişim tekil kişi sayısı ve aynı insan
  /// iki platformda da görüldüyse iki kez sayılır.
  groupId String? @map("group_id") @db.Uuid

  platform    Platform
  adAccountId String   @map("ad_account_id") @db.Uuid

  name String @db.VarChar(200)

  /// Hangi yüzeyden kuruldu: simple | expert.
  ///
  /// Bugünkü `ad_drafts.mode` (simple/advanced) bir ANAHTARDI — aynı taslağın
  /// üzerinde iki görünüm. Burada iki AYRI YÜZEY var: basit yüzey ağacı bir
  /// üreticiyle kuruyor, uzman yüzeyi ağacı doğrudan düzenliyor. Kolonun işi
  /// "bu taslağı hangi ekran açsın" sorusunu cevaplamak.
  surface String @default("simple") @db.VarChar(10)

  /// form | whatsapp | website — basit yüzeyin verdiği tek stratejik karar.
  ///
  /// UZMAN YÜZEYİNDE NULL. Uzman hedefi değil, doğrudan platformun amacını
  /// (`settings.objective`) seçiyor; ona bir `goal` uydurmak, taslağın neye
  /// göre kurulduğu sorusuna yanlış cevap vermek olurdu.
  goal String? @db.VarChar(16)

  /// Platforma özgü kampanya ayarları — amaç, özel reklam kategorisi, teklif.
  ///
  /// JSONB, `ad_drafts.advanced` ile aynı gerekçe: alanlar platformun ve
  /// platform bunları sürümden sürüme değiştiriyor.
  settings Json? @db.JsonB

  /// daily | lifetime | none.
  ///
  /// BÜTÇE İKİ SEVİYEDE OLABİLİR ve hangisinin dolu olduğu anlamlı:
  /// Meta'da kampanya bütçesi (CBO) ile reklam grubu bütçesi (ABO) farklı
  /// dağıtım davranışı demek; Google'da bütçe her zaman kampanya seviyesinde
  /// (`CampaignBudget` ayrı bir kaynak). İkisini birden doldurmak ya da
  /// ikisini birden boş bırakmak geçersiz — kontrol `01_constraints.sql`'de
  /// ve serviste.
  budgetMode         String  @default("none") @map("budget_mode") @db.VarChar(10)
  budgetAmountMicros BigInt? @map("budget_amount_micros")

  startAt DateTime? @map("start_at") @db.Timestamptz(6)
  endAt   DateTime? @map("end_at") @db.Timestamptz(6)

  /// draft | publishing | published | failed — PLATFORM BAŞINA.
  status String @default("draft") @db.VarChar(16)

  /// manual | boost_rule | duplicate — KAMPANYA NEREDEN GELDİ.
  ///
  /// Listede aynı görünen üç satırın hangisinin otomatik açıldığını bilmeden,
  /// beklenmedik bir harcamanın kaynağı bulunamıyor.
  source String @default("manual") @db.VarChar(16)

  /// Kopyanın kaynağı. Kaynak silinince kopya ölmüyor (SET NULL): kopya kendi
  /// başına bir kampanya ve bir taslağı silmek yayındaki beş kampanyayı
  /// düşürmemeli.
  sourceCampaignId String? @map("source_campaign_id") @db.Uuid

  /// Kuraldan doğduysa hangi kural. `source = 'boost_rule'` iken ZORUNLU.
  boostRuleId String? @map("boost_rule_id") @db.Uuid

  externalCampaignId String?   @map("external_campaign_id") @db.VarChar(128)
  error              String?   @db.VarChar(2000)
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount      AdAccount       @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  sourceCampaign DraftCampaign?  @relation("DraftCampaignCopy", fields: [sourceCampaignId], references: [id], onDelete: SetNull)
  copies         DraftCampaign[] @relation("DraftCampaignCopy")
  boostRule      BoostRule?      @relation(fields: [boostRuleId], references: [id], onDelete: SetNull)
  adGroups       DraftAdGroup[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([groupId])
  @@map("draft_campaigns")
}

/// Reklam grubu taslağı (Meta'da ad set, Google'da ad group).
///
/// ÇOKLU: şema baştan birden fazla grubu taşıyor ama arayüz ilk turda tek grup
/// gösteriyor (tasarım belgesi K4). Şemayı sonradan çoğaltmak migration demek;
/// arayüzü açmak bir ekran işi.
model DraftAdGroup {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid

  name String @db.VarChar(200)

  /// Sıra kullanıcının kararı; veritabanı sırası rastgele.
  position Int @default(0)

  /// Reklamın yayınlanacağı Facebook sayfası. Google'da NULL.
  ///
  /// AD SET SEVİYESİNDE çünkü Meta sayfayı burada değil kreatifte istiyor ama
  /// `promoted_object.page_id` ad set'e gidiyor — ikisi ayrı yerler ve bu
  /// ayrımı bir kez canlıda öğrendik (13 Ağustos, 5 numaralı hata: form
  /// kimliği ad set'e konmuştu).
  socialProfileId String? @map("social_profile_id") @db.Uuid
  leadFormId      String? @map("lead_form_id") @db.Uuid

  /// Hedefleme, yerleşim, optimizasyon, teklif — platforma özgü.
  settings Json? @db.JsonB

  budgetMode         String  @default("none") @map("budget_mode") @db.VarChar(10)
  budgetAmountMicros BigInt? @map("budget_amount_micros")

  externalAdSetId String? @map("external_ad_set_id") @db.VarChar(128)
  error           String? @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign      DraftCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile? @relation(fields: [socialProfileId], references: [id], onDelete: SetNull)
  leadForm      LeadForm?      @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  ads           DraftAd[]

  @@index([campaignId, position])
  @@map("draft_ad_groups")
}

/// Reklam taslağı — bir reklam grubunun içindeki tek bir reklam.
///
/// BU TABLONUN VARLIK SEBEBİ A/B TESTİ. Bugün bir taslak tek bir reklam
/// demek ve aynı reklam grubuna ikinci bir metin/görsel denemesi eklemenin
/// yolu yok. Ajans pratiğinde reklam grubu başına 3-5 kreatif standart.
model DraftAd {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  adGroupId String @map("ad_group_id") @db.Uuid

  /// Kütüphaneden gelen kreatif. Boost'ta NULL.
  creativeId String? @map("creative_id") @db.Uuid

  /// Öne çıkarılan organik gönderi. Elle kurulan reklamda NULL.
  ///
  /// BİR BOOST'UN KREATİFİ YOK: metni ve görseli zaten Meta'da duruyor.
  /// İkisinden TAM BİRİ dolu olmak zorunda (`draft_ads_source_chk`) — ikisi
  /// de dolu olsaydı hangisinin yayınlanacağını Meta kendi kararıyla
  /// çözerdi, sessizce.
  organicPostId String? @map("organic_post_id") @db.Uuid

  name String @db.VarChar(200)

  position Int @default(0)

  externalAdId       String? @map("external_ad_id") @db.VarChar(128)
  externalCreativeId String? @map("external_creative_id") @db.VarChar(128)
  error              String? @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  adGroup      DraftAdGroup @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  /// KULLANIMDA OLAN KREATİF SİLİNEMİYOR (Restrict).
  ///
  /// Cascade olsaydı kütüphaneden bir kreatifi silmek, ona bağlı taslak
  /// reklamları sessizce yok ederdi — kullanıcı kütüphaneyi topluyor sanır,
  /// kampanyası eksilir.
  creative     AdCreative?  @relation(fields: [creativeId], references: [id], onDelete: Restrict)
  organicPost  OrganicPost? @relation(fields: [organicPostId], references: [id], onDelete: Cascade)

  @@index([adGroupId, position])
  @@index([creativeId])
  @@index([organicPostId])
  @@map("draft_ads")
}

// -----------------------------------------------------------------------------
// Advetics 1.0 — Otomatik Boost (Instagram + YouTube)
// -----------------------------------------------------------------------------

/// Onaylanınca hangi ayarlarla yayınlanacağı (Advetics 1.0).
///
/// `BoostRule` İLE KARIŞTIRILMAMALI ve o model değiştirilmedi. Fark kavramsal:
/// `BoostRule` bir KURAL MOTORU — koşullar, eşikler, aylık tavan, tur başına
/// aday sayısı — ve gönderileri KENDİSİ SEÇİYOR. Ön ayar hiçbir şey seçmiyor;
/// seçimi kullanıcı tek tıkla yapıyor ve bu model yalnızca "hangi ayarlarla"
/// sorusunu cevaplıyor. 1.0'ın sadeliği tam olarak burada: koşul, eşik, tavan
/// yok.
model AutoBoostPreset {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  clientId String   @map("client_id") @db.Uuid
  /// `meta` → Instagram, `google` → YouTube. Yeni enum açılmadı: YouTube bir
  /// platform değil, Google'ın bir yüzeyi.
  platform Platform

  /// null = müşterinin o platformdaki BÜTÜN profilleri.
  socialProfileId String? @map("social_profile_id") @db.Uuid

  enabled Boolean @default(true)

  /// BÜTÇE KİPE GÖRE AYRI KOLONDA — tek kolona iki anlam yüklenmiyor (K18).
  /// `auto_boost_presets_budget_chk` kipe göre TAM BİRİNİ zorunlu kılıyor.
  ///
  /// GOOGLE'DA `lifetime` YASAK (`auto_boost_presets_google_daily_chk`):
  /// orada bütçe ayrı bir kaynak ve günlük; toplamı günlüğe bölmek panelde
  /// yazan tutar ile hesaptan çıkanı ayrıştırır.
  budgetMode        String  @default("daily") @map("budget_mode") @db.VarChar(10)
  dailyBudgetMicros BigInt? @map("daily_budget_micros")
  totalBudgetMicros BigInt? @map("total_budget_micros")
  durationDays      Int     @default(3) @map("duration_days")

  /// Platforma özgü ayarlar — Zod ayrık birleşimiyle doğrulanıyor.
  ///
  /// JSONB, çünkü iki platformun alanları ortak değil ve hepsini kolona açmak
  /// yarısı her zaman NULL olan bir tablo demekti. GÜVENLİ, çünkü bu JSON
  /// platforma OLDUĞU GİBİ GİTMİYOR: okunurken doğrulanıp alan alan
  /// eşleniyor. (Ham JSON'u platforma geçirmek, uydurulmuş bir anahtarın
  /// sessizce yok sayılması demek olurdu.)
  settings Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile?       @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  queueItems    AutoBoostQueueItem[]

  @@index([clientId, platform])
  @@map("auto_boost_presets")
}

/// Onay bekleyen gönderi/video — "Bildirim Havuzu" (Advetics 1.0).
///
/// Instagram gönderisi ve YouTube videosu AYNI tabloda: panelde tek bir havuz
/// gösteriliyor ve iki ayrı kaynaktan sıralama/sayfalama doğru kurulamazdı.
model AutoBoostQueueItem {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  clientId String   @map("client_id") @db.Uuid
  platform Platform

  /// Hangi hesaptan geldi. NULL OLAMAZ — reklam bir sayfa/kanal adına
  /// yayınlanıyor ve hangisi olduğu bilinmeden yayın kurulamaz.
  socialProfileId String @map("social_profile_id") @db.Uuid

  /// İDEMPOTENCY ANAHTARI — bu modelin en kritik alanı.
  ///
  /// Instagram medya kimliği ya da YouTube video kimliği. Webhook teslimi
  /// GARANTİ DEĞİL ve MÜKERRER olabiliyor. Tekillik kısıtı olmasa aynı
  /// gönderi için iki kart düşer, ikisi de onaylanırsa AYNI İÇERİK İÇİN İKİ
  /// REKLAM açılır. Kısıt veritabanında çünkü iki webhook aynı anda gelebiliyor
  /// ve "önce bak sonra yaz" yarışı kaybediyor.
  externalId String @map("external_id") @db.VarChar(128)

  title        String?   @db.VarChar(2000)
  thumbnailUrl String?   @map("thumbnail_url")
  permalink    String?
  mediaType    String?   @map("media_type") @db.VarChar(32)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)

  /// pending | approved | rejected | launching | launched | failed
  ///
  /// `launching` AYRI BİR DURUM: onay ile platformda oluşma arasında saniyeler
  /// var ve süreç orada düşerse kayıt `pending` kalmamalı — kalırsa ikinci kez
  /// onaylanır ve İKİNCİ reklam açılır.
  status String @default("pending") @db.VarChar(16)

  /// Onay anındaki ön ayar ve onun KOPYASI. Ön ayar sonradan değişse bile bu
  /// kaydın hangi ayarlarla yayınlandığı okunabilmeli.
  appliedPresetId String? @map("applied_preset_id") @db.Uuid
  appliedSettings Json?   @map("applied_settings") @db.JsonB

  /// Meta yolunda `boosts` satırı da yazılıyor (harcama muhasebesi ve ağaç
  /// oradan işliyor); Google yolunda karşılığı yok, kimlikler doğrudan burada.
  boostId            String? @map("boost_id") @db.Uuid
  externalCampaignId String? @map("external_campaign_id") @db.VarChar(128)
  externalAdGroupId  String? @map("external_ad_group_id") @db.VarChar(128)
  externalAdId       String? @map("external_ad_id") @db.VarChar(128)

  error String? @db.VarChar(1000)

  /// Bildirimin KÖKENİ — sahte ile gerçeği ayırt etmek için.
  ///
  /// `imzasiz` gelen kart panelde İŞARETLİ görünüyor: koruma o kart için
  /// yalnızca adresin gizli kalmasına dayanıyor demektir ve kullanıcı bunu
  /// bilmeli. Alan olmadan sızan bir belirtecin haftalarca fark edilmeden
  /// kullanılması mümkündü.
  signatureState String? @map("signature_state") @db.VarChar(16)

  /// Kaynak IP — BEYAZ LİSTE İÇİN DEĞİL. App Engine çıkış IP'leri bütün
  /// Google Cloud kiracılarıyla ortak; beyaz liste kimseyi dışarıda
  /// bırakmadan savunma görüntüsü verirdi. Yalnızca olay sonrası inceleme.
  sourceIp String? @map("source_ip") @db.VarChar(64)

  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  launchedAt DateTime? @map("launched_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile    @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  appliedPreset AutoBoostPreset? @relation(fields: [appliedPresetId], references: [id], onDelete: SetNull)
  boost         Boost?           @relation(fields: [boostId], references: [id], onDelete: SetNull)

  @@unique([socialProfileId, externalId])
  @@index([clientId, status, createdAt(sort: Desc)])
  @@map("auto_boost_queue_items")
}

/// YouTube bildirim aboneliği (WebSub) — Advetics 1.0.
///
/// GÜVENLİK İNCELEMESİNDEN SONRA ŞEKİLLENDİ. İlk tasarım üç kritik noktadan
/// düştü ve üçünün karşılığı burada: imza kilidi, belirtecin düz metin
/// saklanmaması ve iptal edilebilir olması.
model AutoBoostSubscription {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// Bir kanal = bir abonelik.
  socialProfileId String @unique @map("social_profile_id") @db.Uuid

  /// `hub.topic` — doğrulama el sıkışmasında gelen konu bununla
  /// karşılaştırılıyor. Eşleşme aranmasa başkası bizim geri çağrı adresimizi
  /// kullanarak KENDİ kanalını abone ettirebilirdi.
  topicUrl String @map("topic_url")

  /// BELİRTECİN KENDİSİ SAKLANMIYOR — ana anahtardan ve bu nonce'tan
  /// türetiliyor. Burada yalnızca SHA-256 özeti var ve tek işi gelen
  /// istekteki belirteçten profili BULMAK. Düz metin saklansaydı her
  /// veritabanı dökümü canlı bir kimlik bilgisi taşırdı.
  ///
  /// NONCE DÖNDÜRÜLEBİLİR: sızıntı şüphesinde yenileniyor, eski adres anında
  /// ölüyor. İlk tasarımda iptal yolu hiç yoktu.
  tokenNonce        String @map("token_nonce") @db.VarChar(64)
  callbackTokenHash String @unique @map("callback_token_hash") @db.Char(64)

  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  leaseSeconds Int?      @map("lease_seconds")
  renewAt      DateTime? @map("renew_at") @db.Timestamptz(6)

  /// ÖĞREN-VE-KİLİTLE. İlk geçerli imza görüldüğü an doluyor; doluysa imzasız
  /// istek ARTIK reddediliyor.
  ///
  /// Baştan zorunlu değil çünkü Google hub'ının `hub.secret`'ı dikkate alıp
  /// almadığı ölçülmedi — zorunlu kılmak, imzalamıyorsa özelliğin hiç
  /// çalışmaması demekti. Bu alan ikisini de çözüyor.
  signatureSeenAt DateTime? @map("signature_seen_at") @db.Timestamptz(6)

  /// Ölü adam düğmesi buna bakıyor.
  lastNotificationAt DateTime? @map("last_notification_at") @db.Timestamptz(6)

  /// `hub.mode=denied` sebebi. Doluysa abonelik ÖLÜ ve panel göstermeli.
  deniedReason String? @map("denied_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@index([renewAt])
  @@map("auto_boost_subscriptions")
}
