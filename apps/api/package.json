    "db:seed-portfolio": "tsx prisma/seed-portfolio.ts",
    "db:reset-clients": "tsx prisma/reset-clients.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:set-password": "tsx prisma/set-password.ts",
    "sync": "tsx prisma/sync-cli.ts",
    "google-check": "node dist/google-check.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "youtube-check": "tsx prisma/youtube-check.ts"
  },
  "dependencies": {
    "@advetics/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
