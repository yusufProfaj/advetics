# =============================================================================
# Advetics — Ortam Değişkenleri
# Kopyala: cp .env.example .env
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Veritabanı
# -----------------------------------------------------------------------------
# DATABASE_URL       -> API runtime. RLS UYGULANIR. Normal istekler bunu kullanır.
# DIRECT_DATABASE_URL-> Prisma migrate + seed. Tablo sahibi, BYPASSRLS.
# WORKER_DATABASE_URL-> Arka plan worker'ları. BYPASSRLS. (Modül 3'te kullanılacak)
DATABASE_URL="postgresql://advetics_app:dev_app_pw@localhost:5433/advetics?schema=public"
DIRECT_DATABASE_URL="postgresql://advetics_migrator:dev_migrator_pw@localhost:5433/advetics?schema=public"
WORKER_DATABASE_URL="postgresql://advetics_worker:dev_worker_pw@localhost:5433/advetics?schema=public"

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=4000
# Dinlenecek arayüz. Üretimde 127.0.0.1 — API'ye tek giriş Nginx olmalı.
API_HOST=127.0.0.1
API_GLOBAL_PREFIX=api
# Virgülle ayrılmış origin listesi. White-label custom domain'ler buraya eklenir.
CORS_ORIGINS="http://localhost:3000"

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Üretmek için: openssl rand -base64 48
JWT_ACCESS_SECRET="degistir-bunu-en-az-32-karakter-olmali-access"
JWT_REFRESH_SECRET="degistir-bunu-en-az-32-karakter-olmali-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Cookie'lerin geçerli olacağı domain. Alt alan adları için başına nokta koy: .advetics.com
AUTH_COOKIE_DOMAIN="localhost"
AUTH_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Uygulama katmanı şifreleme (OAuth token'ları — Modül 2)
# 32 byte, base64. Üretmek için: openssl rand -base64 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEY_V1="ZGVnaXN0aXItYnVudS0zMi1ieXRlLWJhc2U2NC1rZXk="
ENCRYPTION_ACTIVE_KEY_VERSION=1

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# DİKKAT: NEXT_PUBLIC_* değerleri BUILD ANINDA koda gömülür.
# Değiştirdikten sonra pm2 restart yetmez, yeniden build almak gerekir.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# White-label ana domain — bunun dışındaki host'lar custom domain kabul edilir
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Next.js sunucu tarafının API'ye doğrudan eriştiği adres (Nginx'i atlar).
# Üretimde: http://127.0.0.1:3599/api — bkz. docs/DEPLOYMENT.md
INTERNAL_API_URL="http://localhost:4000/api"

# -----------------------------------------------------------------------------
# Seed (yalnızca geliştirme)
#
# PAROLA BURAYA YAZILMAZ — depo herkese açık (CLAUDE.md §2).
#
# Bu satır bir süre somut bir varsayılan taşıdı ve o, depoyu okuyan herkesin
# bildiği bir parola demekti: `SEED_ADMIN_EMAIL` hesabı o değeri hâlâ
# kullanıyorsa giriş herkese açıktır. Örnek dosyada gerçek bir değer tutmanın
# "kolaylık" tarafı yok; kopyalayan kişi zaten kendi değerini yazmak zorunda.
#
# Yeni bir parola üretmek için:
#   openssl rand -base64 24
# -----------------------------------------------------------------------------
SEED_ORG_NAME="Advetics"
SEED_ADMIN_EMAIL="yusuf@profaj.com"
SEED_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Modül 2 — Platform kimlik bilgileri
#
# Hepsi OPSİYONEL: eksikse uygulama yine açılır, ilgili platformun "Bağlan"
# butonu pasif görünür. Meta App Review / Google Developer Token onayı
# beklenirken geliştirme durmaz.
# -----------------------------------------------------------------------------

# OAuth callback'lerin döneceği kök adres. Üretimde: https://advetics.com
OAUTH_REDIRECT_BASE_URL="http://localhost:3000"

# Meta uygulaması — developers.facebook.com
# Callback URL olarak şunu kaydet: <OAUTH_REDIRECT_BASE_URL>/api/connections/meta/callback
META_APP_ID=""
META_APP_SECRET=""
# CANLIYA ALMADAN ÖNCE güncel sürümü doğrula:
# https://developers.facebook.com/docs/graph-api/changelog
META_API_VERSION="v25.0"

# Google Cloud OAuth istemcisi + Ads API developer token
# Callback URL: <OAUTH_REDIRECT_BASE_URL>/api/connections/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Basic Access onayı olmadan yalnızca test hesapları görünür
GOOGLE_ADS_DEVELOPER_TOKEN=""
# CANLIYA ALMADAN ÖNCE doğrula:
# https://developers.google.com/google-ads/api/docs/release-notes
GOOGLE_ADS_API_VERSION="v25"

# -----------------------------------------------------------------------------
# Modül 3 — Kuyruk ve kota (Redis)
#
# PAYLAŞIMLI REDIS UYARISI: bu sunucuda başka uygulamalar da Redis kullanıyor.
# İzolasyon iki katmanlı ve İKİSİ de gerekli:
#   · REDIS_DB        → ayrı veritabanı numarası (db0 başkalarının)
#   · REDIS_KEY_PREFIX → BullMQ ve kota anahtarlarının öneki
# Bu ikisi olmadan `queue:sync` gibi genel adlar çakışır ve başka bir
# uygulamanın işlerini silebiliriz.
# -----------------------------------------------------------------------------
# PORT 6380 — 6379 DEĞİL. `docker-compose.yml` Redis'i `6380:6379` ile
# yayınlıyor: geliştirme makinesinde 6379'da başka bir Redis olabiliyor ve
# çakışan bir kuyruk, başka bir uygulamanın işlerini silmek demek.
#
# BU SATIR BİR KEZ YAZILIR. Dosyada iki `REDIS_URL` vardı (biri 6380, biri
# 6379) ve dotenv SONUNCUYU kazandırıyor — kopyalayan herkes var olmayan bir
# porta bakan bir URL alıyordu. Arıza SESSİZ: kota bekçisi URL'nin varlığına
# bakıyor, ERİŞİLEBİLİRLİĞİNE değil; API kotayı "açık" sayıp komutları
# sonsuza kadar kuyrukta bekletiyor. Yalnızca worker yüksek sesle ölüyor.
# `ornek-env-sir.spec.ts` mükerrer anahtarı ve portu artık tarıyor.
#
# SUNUCUDA FARKLI: orada sistem Redis'i 6379'da ve `.env` git'te değil.
REDIS_URL="redis://127.0.0.1:6380"
REDIS_DB="3"
REDIS_KEY_PREFIX="advetics"

# Hesap başına dakikadaki maksimum API çağrısı — kotanın SABİT tabanı.
# Platform kota yüzdesi bildirmeye başlayınca eşik kendiliğinden daralır
# (%60 üstünde yarıya, %75 üstünde çeyreğe). Bu bütçenin %65'i senkronizasyona,
# kalan %35'i kural aksiyonları ve kullanıcı isteklerine rezerve edilir.
QUOTA_CALLS_PER_MINUTE="60"

# -----------------------------------------------------------------------------
# YouTube Data API — Advetics 1.0 otomatik boost
# -----------------------------------------------------------------------------
# İSTEĞE BAĞLI. Yoksa uygulama normal açılır; yalnızca YouTube otomatik boost'u
# çalışmaz ve panel bunu SÖYLER.
#
# OAUTH DEĞİL, API ANAHTARI. `videos.list` herkese açık veri okuyor ve kullanıcı
# adına işlem yapmıyor. Bu önemli: yeni bir OAuth kapsamı eklemek canlı Google
# Ads bağlantısının yeniden yetkilendirilmesini gerektirirdi ve bu projede
# yeniden yetkilendirme daha önce bağlantıları koparmıştı.
#
# NE İŞE YARIYOR: YouTube bildirimi geldiğinde gövdedeki video kimliği
# doğrulanmadan kart açılmıyor. Doğrulanmazsa, bildirim adresini ele geçiren
# biri müşterinin bütçesiyle BAŞKASININ videosunu tanıtabiliyor.
#
# Alma ve KISITLAMA adımları: docs/DEPLOYMENT.md §5c
# Kısıtlamadan bırakılan anahtar, eline geçen herkesin kotayı harcamasına
# izin verir.
YOUTUBE_API_KEY=""

# -----------------------------------------------------------------------------
# LinkedIn Ads (üçüncü platform — 2026-09-07)
#
# ONAY BEKLİYOR. LinkedIn Advertising API "Development Tier" başvurusu
# 2026-09-07'de yapıldı; onay gelmeden hiçbir çağrı başarılı olmuyor çünkü
# uygulamaya henüz SCOPE atanmamış durumda (Developer Portal > Auth sayfası
# "No permissions added" diyor). Bu üç alan o yüzden opsiyonel: panel onay
# beklenirken de ayağa kalkmalı ve eksik anahtarları EKRANDA yazmalı.
#
# CLIENT SECRET BU DOSYAYA YAZILMAZ. Depo herkese açık; değer yalnızca
# sunucudaki `.env`e giriyor. `ornek-env-sir.spec.ts` bunu tarıyor.
#
# REDIRECT URL LinkedIn konsolunda BİREBİR kayıtlı olmak zorunda:
#   https://advetics.com/api/connections/linkedin/callback
# (üretici: connections.service.ts → redirectUri())
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# `LinkedIn-Version` başlığı — YYYYMM. ZORUNLU ve varsayılanı YOK: LinkedIn
# "en yeni sürüm" diye bir davranış uygulamıyor, başlık eksikse istek düşüyor
# ve sürüm ömrünü doldurunca HTTP 426 dönüyor. Her sürüm ~12 ay yaşıyor, yani
# bu satır yılda en az bir kez güncellenmek zorunda.
#
# TAKVİMDEN ÜRETİLEMEZ: LinkedIn'in ARALIK SÜRÜMÜ YOK (202510, 202511, sonra
# doğrudan 202601). Aydan sürüm türeten bir kod her Aralık patlar.
LINKEDIN_API_VERSION="202608"

# -----------------------------------------------------------------------------
# AI Kampanya Asistanı (panel içi sohbet — 2026-09-08)
#
# İSTEĞE BAĞLI. Yoksa uygulama normal açılır; yalnızca panel içi AI asistanı
# çalışmaz. `YOUTUBE_API_KEY` ile aynı desen.
#
# Asistan yalnızca TASLAK oluşturur (`bulk.write`) — yayınlama her zaman
# panelin kendi "Yayınla" butonundan (`bulk.publish`, ayrı izin). Bütçe/
# pause/resume gibi canlı mutasyonlar chat içi bir onay kartı gerektiriyor.
ANTHROPIC_API_KEY=""
# Model kimliği elle yönetiliyor. Sabit tutulmalı — redeploy'lar arası aynı
# davranışı garantiler; "en yenisi" gibi bir otomatik yükseltme YOK.
ANTHROPIC_MODEL="claude-sonnet-5"

# -----------------------------------------------------------------------------
# SİSTEM E-POSTASI (şifre sıfırlama — 2026-09-09)
#
# Kullanıcının KENDİ SMTP kimliği Ayarlar > E-posta altında duruyor ve rapor
# gönderimini besliyor; o kimlik GİRİŞ YAPMIŞ olmayı gerektiriyor. Şifre
# sıfırlama maili ise tam olarak giriş YAPAMAYAN birine gidiyor — bu yüzden
# sunucuya ait ayrı bir gönderici gerekiyor.
#
# İSTEĞE BAĞLI VE AÇILIŞTA PATLATMIYOR: eksikse API normal ayağa kalkıyor,
# yalnızca "şifremi unuttum" ekranı hangi değişkenlerin eksik olduğunu
# ADIYLA söyleyip duruyor. Sessizce "gönderildi" YAZMIYOR — bu akış zaten
# bir kez ölü doğdu (token üretiliyor, hash'leniyor, düz metni atılıyordu).
#
# PAROLA BURAYA YAZILMAZ — depo herkese açık (CLAUDE.md §2). Gmail için
# hesap parolası değil UYGULAMA ŞİFRESİ kullanılıyor (2FA açıkken):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT=465
# 465 => true (SMTPS). 587 kullanılacaksa false (STARTTLS).
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Advetics"

# Panelin DIŞARIDAN görünen kök adresi. Sıfırlama bağlantısı buradan kuruluyor.
# Boş bırakılırsa OAUTH_REDIRECT_BASE_URL kullanılıyor — ikisi de aynı paneli
# gösteriyor ve iki ayrı zorunlu değişken, birinin unutulup ayrışması demek.
APP_URL=""
